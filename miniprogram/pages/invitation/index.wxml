<view class="screen"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">邀请家人</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner">
<view wx:if="{{status === 'loading'}}"><view class="skeleton"></view><text class="end-note">正在查看邀请…</text></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">邀请暂时没有加载出来</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="load">重新加载</button></view>
<block wx:else><block wx:if="{{familyId}}"><view class="flow-card"><text class="h3">{{family.name}}</text><text class="paragraph">邀请可转发，持有者可加入。有效期 7 天，无需额外审批。</text><button wx:if="{{owner}}" class="primary-button full-width" bindtap="create" disabled="{{writing || uncertain}}">生成新邀请</button><text wx:else class="flow-notice">只有当前家庭拥有人可以管理邀请。</text></view><view wx:if="{{generatedToken}}" class="flow-card"><text class="h3">邀请已生成</text><text class="paragraph">有效至 {{expiresLabel}}</text><text selectable class="paragraph">{{generatedToken}}</text><view class="flow-inline-actions"><button class="outline-button" bindtap="copyToken">复制口令</button><button class="outline-button" bindtap="copyPath">复制加入路径</button><button class="primary-button" open-type="share">邀请家人</button></view></view><view wx:for="{{invitations}}" wx:key="id" class="flow-card"><text class="h3">{{item.state}}</text><text class="paragraph">有效至 {{item.expiresLabel}}</text><button wx:if="{{!item.revokedAt && owner}}" class="outline-button" data-id="{{item.id}}" bindtap="revoke" disabled="{{writing || uncertain}}">撤销邀请</button></view></block>
<view wx:elif="{{joinedId}}" class="flow-card"><text class="h3">你已加入这个家庭</text><text class="paragraph">重复接受不会再次添加成员。</text><button class="primary-button full-width" bindtap="openFamily">查看家人</button></view>
<block wx:else><view class="flow-card"><text class="field-label">邀请口令</text><input class="form-input" value="{{token}}" maxlength="22" bindinput="tokenInput" disabled="{{writing || uncertain}}" placeholder="填写家人分享的口令"/><button class="outline-button full-width" bindtap="previewInvitation" disabled="{{writing || uncertain}}">查看邀请</button></view><view wx:if="{{preview}}" class="flow-card"><text class="h3">{{preview.alreadyJoined ? '你已加入这个家庭' : '一起照应日常的小事'}}</text><text class="paragraph">{{preview.inviterName}}邀请你加入「{{preview.familyName}}」。接受后成为普通成员。</text><text class="paragraph">有效至 {{expiresLabel}}</text><text class="field-label">在家里的称呼</text><input class="form-input" value="{{myName}}" maxlength="12" bindinput="nameInput" disabled="{{writing || uncertain}}"/><button class="primary-button full-width" bindtap="accept" disabled="{{writing || uncertain}}">{{preview.alreadyJoined ? '确认已加入并查看家庭' : '接受邀请并加入'}}</button></view><view wx:elif="{{error}}" class="flow-notice">这个邀请暂时不可用，请检查口令或联系家人重新发出邀请。</view></block></block><text class="form-error">{{error}}</text><button wx:if="{{uncertain}}" class="primary-button full-width" bindtap="retryWrite" loading="{{writing}}">重试确认本次操作</button></view></scroll-view></view>
