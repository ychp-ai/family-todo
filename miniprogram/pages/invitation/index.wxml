<import src="../../templates/loading.wxml"/>
<view class="screen family-flow"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">邀请家人</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner">
<view wx:if="{{status === 'loading'}}"><template is="loading-cards" data="{{kind: 'form', label: '正在查看邀请…'}}"/></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">邀请暂时没有加载出来</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="load">重新加载</button></view>
<block wx:else><block wx:if="{{familyId}}"><invitation-create family="{{family}}" owner="{{owner}}" writing="{{writing}}" uncertain="{{uncertain}}" bind:action="onComponentAction"/><invitation-token wx:if="{{generatedToken}}" generated-token="{{generatedToken}}" expires-label="{{expiresLabel}}" bind:action="onComponentAction"/><invitation-card wx:for="{{invitations}}" wx:key="id" owner="{{owner}}" writing="{{writing}}" uncertain="{{uncertain}}" item="{{item}}" bind:action="onComponentAction"/></block>
<view wx:elif="{{joinedId}}" class="flow-card"><text class="h3">你已加入这个家庭</text><text class="paragraph">重复接受不会再次添加成员。</text><button class="primary-button full-width" bindtap="openFamily">查看家人</button></view>
<block wx:else><invitation-input wx:if="{{!fromShare || !preview}}" token="{{token}}" writing="{{writing}}" uncertain="{{uncertain}}" bind:action="onComponentAction"/><invitation-preview wx:if="{{preview}}" expires-label="{{expiresLabel}}" my-name="{{myName}}" preview="{{preview}}" writing="{{writing}}" uncertain="{{uncertain}}" bind:action="onComponentAction"/><view wx:elif="{{error}}" class="flow-notice">这个邀请暂时不可用，请检查口令或联系家人重新发出邀请。</view></block></block><text class="form-error">{{error}}</text><button wx:if="{{uncertain}}" class="primary-button full-width" bindtap="retryWrite" loading="{{writing}}">重试确认本次操作</button></view></scroll-view></view>
