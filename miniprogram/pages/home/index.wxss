.recycle-entry{display:flex;margin:4px auto 0}

/* 原生 tabBar 已占用底部安全区。 */
.phone-bottom{position:relative;z-index:1;padding-bottom:12px}

.home-scroll{position:relative;z-index:0;overflow:hidden}
.task-list-region{position:relative;min-height:160px;overflow:hidden}
.list-refresh-mask{position:absolute;inset:0;z-index:10;display:flex;align-items:flex-start;justify-content:center;padding-top:72px;background:rgba(244,245,250,.72);border-radius:var(--radius-card)}
.list-refresh-indicator{display:flex;align-items:center;gap:10px;padding:14px 20px;background:var(--paper);border-radius:var(--radius-control);color:var(--muted);font-size:14px}
.list-refresh-spinner{width:18px;height:18px;border:2px solid var(--line);border-top-color:var(--brand);border-radius:50%;animation:list-refresh-spin .8s linear infinite}
@keyframes list-refresh-spin{to{transform:rotate(360deg)}}
