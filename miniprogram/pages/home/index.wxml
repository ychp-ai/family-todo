<view class="screen">
  <view class="status-space" style="height:{{statusHeight}}px"></view>
  <view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><view class="app-name"><image src="/assets/app-icon.png"/>家庭待办</view></view>
  <scroll-view class="phone-scroll home-scroll" scroll-y refresher-enabled="{{!writing && !saving && !batchBusy && !batchMode && !uncertain}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="pullRefresh"><view class="scroll-inner">
    <view class="home-greeting"><view><text class="overline">{{greeting || ' '}}</text><text class="h3">今天，也要好好过<text class="greeting-dot">。</text></text></view></view>
    <home-reminder-banner reminder-count="{{reminderCount}}" reminder-error="{{reminderError}}" bind:action="onComponentAction"/>
    <home-filters batch-mode="{{batchMode}}" family-options="{{familyOptions}}" family-index="{{familyIndex}}" bind:action="onComponentAction"/>
    <home-date-tabs today="{{today}}" tab="{{tab}}" selected-date="{{selectedDate}}" bind:action="onComponentAction"/>
    <view wx:if="{{tab === 'calendar'}}" class="form-helper">{{selectedDate}}</view>
    <view class="list-summary"><text>{{summaryText}}</text><button class="text-button" bindtap="toggleCompleted">{{hideCompleted ? '显示已完成' : '隐藏已完成'}}</button></view><view class="progress-track"><view style="width:{{progress + '%'}};"></view></view>
    <view wx:if="{{status === 'loading'}}"><view class="skeleton"></view><view class="skeleton"></view><view class="skeleton"></view><text class="end-note">正在加载事项…</text></view>
    <view wx:elif="{{status === 'error'}}" class="state-box"><image class="icon" src="/assets/repeat-brand.svg"/><text class="h4">事项暂时没有加载出来</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="retry">重新加载</button></view>
    <view wx:elif="{{status === 'empty'}}" class="state-box"><image class="icon" src="/assets/calendar-brand.svg"/><text class="h4">{{tab === 'tomorrow' ? '给明天留个小安排' : '这里还没有安排'}}</text><text class="paragraph">从一件小事开始，
只填标题也能记下来。</text><button class="outline-button" bindtap="openQuick">记一件事</button></view>
    <view wx:else><view wx:for="{{groups}}" wx:for-item="group" wx:key="name" class="task-group"><view class="group-label">{{group.name}} <text>{{group.items.length}}</text></view><home-task-card wx:for="{{group.items}}" wx:key="id" batch-mode="{{batchMode}}" writing="{{writing && writingKey === 'toggle:' + item.occurrence.id}}" item="{{item}}" bind:action="onComponentAction"/></view><view wx:if="{{!visibleItems.length && !error}}" class="state-box"><text class="h4">这一页的事情都完成了</text><text class="paragraph">点击“显示已完成”回看记录。</text></view></view>
    <button wx:if="{{tab === 'today' && backlog.length && status !== 'error'}}" class="backlog" bindtap="openBacklog"><image class="icon tiny" src="/assets/clock.svg"/><text>之前还有 {{backlog.length}} 件未完成</text><image class="icon tiny" src="/assets/chevron.svg"/></button>
    <button wx:if="{{error && status !== 'error'}}" class="text-button" bindtap="retry">{{error}}</button>
    <button wx:if="{{pendingCount}}" class="outline-button full-width" bindtap="retryPending" loading="{{writing}}">有未确认的操作 · 重试确认结果</button><text class="form-error">{{quickError}}</text><text class="form-error">{{batchError}}</text><button wx:if="{{batchResults.length}}" class="text-button" bindtap="showBatchResult">查看批量结果</button><button class="text-button" bindtap="openRecycle">回收站</button><text class="end-note">一家人的小事，一件一件来。</text>
  </view></scroll-view>
  <view class="phone-bottom"><button wx:if="{{batchMode}}" class="primary-button full-width" bindtap="openBatch" disabled="{{!selectedTasks.length}}">批量增加可见人 · {{selectedTasks.length}} / 20 项</button><button wx:else class="primary-button add-button" bindtap="openQuick" disabled="{{!today || saving || writing || uncertain}}"><image class="icon" src="/assets/plus-white.svg"/>记一件事</button></view>
</view>
<view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-header"><text class="h2">{{sheet === 'batch' ? '批量增加可见人' : sheet === 'quick' ? '记一件事' : sheet === 'reminders' ? '到时提醒' : '之前未完成'}}</text><button class="icon-button" bindtap="closeSheet" aria-label="关闭"><image class="icon" src="/assets/close.svg"/></button></view><scroll-view class="sheet-scroll" scroll-y>
  <block wx:if="{{sheet === 'batch'}}"><text class="sheet-message">按家庭分别选择。保留已有可见人，不增加代记或提醒权限。</text><home-batch-group wx:for="{{batchGroups}}" wx:key="key" batch-busy="{{batchBusy}}" batch-family-options="{{batchFamilyOptions}}" pending-count="{{pendingCount}}" item="{{item}}" bind:action="onComponentAction"/><button wx:if="{{batchGroups.length && !batchResults.length && !pendingCount}}" class="primary-button full-width" bindtap="submitBatch" disabled="{{batchBusy}}" loading="{{batchBusy}}">确认增加可见人</button><view wx:for="{{batchResults}}" wx:key="taskId" class="history-item"><text class="strong">第 {{index + 1}} 项 · {{item.status === 'succeeded' ? '成功' : item.status === 'pending' ? '待确认' : '失败'}}</text><text class="paragraph">{{item.label}}</text></view><button wx:if="{{pendingCount}}" class="primary-button full-width" data-mode="continue" bindtap="submitBatch" disabled="{{batchBusy}}" loading="{{batchBusy}}">继续确认本次批量操作</button><button wx:if="{{batchComplete && batchHasFailures}}" class="outline-button full-width" data-mode="failed" bindtap="submitBatch" disabled="{{batchBusy}}" loading="{{batchBusy}}">仅重试失败项</button><text class="form-error">{{batchError}}</text></block>
  <home-quick-form wx:elif="{{sheet === 'quick'}}" quick-family-index="{{quickFamilyIndex}}" quick-family-options="{{quickFamilyOptions}}" quick-subject-names="{{quickSubjectNames}}" quick-subject-index="{{quickSubjectIndex}}" quick-rows="{{quickRows}}" quick-notice="{{quickNotice}}" quick-loading="{{quickLoading}}" quick-title="{{quickTitle}}" quick-date="{{quickDate}}" quick-time="{{quickTime}}" quick-repeat-index="{{quickRepeatIndex}}" quick-repeat-options="{{quickRepeatOptions}}" quick-note="{{quickNote}}" quick-reminder="{{quickReminder}}" expanded="{{expanded}}" quick-error="{{quickError}}" quick-success="{{quickSuccess}}" saving="{{saving}}" uncertain="{{uncertain}}" writing="{{writing}}" bind:action="onComponentAction"/>
  <block wx:elif="{{sheet === 'reminders'}}"><text class="sheet-message">汇总所有家庭中提醒你的事项。
仅在使用小程序时提示，关闭后不会发送微信通知。</text><button class="text-button" bindtap="toggleDismissed">{{includeDismissed ? '隐藏已收起' : '查看已收起'}}</button><button wx:if="{{reminderError}}" class="text-button" bindtap="retry">{{reminderError}}</button><home-reminder-card wx:for="{{reminders}}" wx:key="id" writing="{{writing}}" item="{{item}}" bind:action="onComponentAction"/><view wx:if="{{!reminders.length && !reminderError}}" class="state-box"><text class="h4">暂时没有待处理的到时提醒</text><text class="paragraph">完成事项后，对应提示会一起撤下。</text></view></block>
  <block wx:else><home-backlog-card wx:for="{{backlog}}" wx:key="id" batch-mode="{{batchMode}}" writing="{{writing && writingKey === 'toggle:' + item.occurrence.id}}" item="{{item}}" bind:action="onComponentAction"/></block>
</scroll-view></view></view>
