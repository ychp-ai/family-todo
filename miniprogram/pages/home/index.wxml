<view class="screen">
  <view class="status-space" style="height:{{statusHeight}}px"></view>
  <view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><view class="app-name"><image src="/assets/app-icon.png"/>家庭待办</view></view>
  <scroll-view class="phone-scroll home-scroll" scroll-y><view class="scroll-inner">
    <view class="home-greeting"><view><text class="overline">{{greeting || ' '}}</text><text class="h3">今天，也要好好过<text class="greeting-dot">。</text></text></view><button class="family-entry" bindtap="openFamilies" aria-label="查看家人"><image class="icon" src="/assets/people-brand.svg"/></button></view>
    <button class="reminder-banner" bindtap="openReminders"><view class="reminder-icon"><image class="icon" src="/assets/bell-brand.svg"/></view><view><text class="strong">{{reminderError || reminderCount + ' 件事到提醒时间了'}}</text><text class="small">自己的安排、爸妈的牵挂</text></view><image class="icon chevron" src="/assets/chevron.svg"/></button>
    <view class="filter-row"><picker range="{{familyOptions}}" value="{{familyIndex}}" bindchange="familyChange"><view class="family-filter"><image class="icon" src="/assets/home-brand.svg"/><text>{{familyOptions[familyIndex]}}</text><image class="icon tiny" src="/assets/down.svg"/></view></picker><button class="text-button" bindtap="futureFeature">{{batchMode ? '取消多选' : '多选'}}</button></view>
    <view class="date-tabs"><button class="{{tab === 'today' ? 'active' : ''}}" data-tab="today" bindtap="changeTab">今天 <text>{{todayDay}}</text></button><button class="{{tab === 'tomorrow' ? 'active' : ''}}" data-tab="tomorrow" bindtap="changeTab">明天 <text>{{tomorrowDay}}</text></button><button class="{{tab === 'unscheduled' ? 'active' : ''}}" data-tab="unscheduled" bindtap="changeTab">未安排</button><picker mode="date" value="{{selectedDate || today}}" bindchange="pickDate"><button class="calendar-button {{tab === 'calendar' ? 'active' : ''}}" aria-label="选择其他日期"><image class="icon" src="/assets/calendar.svg"/></button></picker></view>
    <view wx:if="{{tab === 'calendar'}}" class="form-helper">{{selectedDate}}</view>
    <view class="list-summary"><text>{{summaryText}}</text><button class="text-button" bindtap="toggleCompleted">{{hideCompleted ? '显示已完成' : '隐藏已完成'}}</button></view><view class="progress-track"><view style="width:{{progress}}%"></view></view>
    <view wx:if="{{status === 'loading'}}"><view class="skeleton"></view><view class="skeleton"></view><view class="skeleton"></view><text class="end-note">正在加载事项…</text></view>
    <view wx:elif="{{status === 'error'}}" class="state-box"><image class="icon" src="/assets/repeat-brand.svg"/><text class="h4">事项暂时没有加载出来</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="retry">重新加载</button></view>
    <view wx:elif="{{status === 'empty'}}" class="state-box"><image class="icon" src="/assets/calendar-brand.svg"/><text class="h4">{{tab === 'tomorrow' ? '给明天留个小安排' : '这里还没有安排'}}</text><text class="paragraph">从一件小事开始，
只填标题也能记下来。</text><button class="outline-button" bindtap="openQuick">记一件事</button></view>
    <view wx:else><view wx:for="{{groups}}" wx:for-item="group" wx:key="name" class="task-group"><view class="group-label">{{group.name}} <text>{{group.items.length}}</text></view><view wx:for="{{group.items}}" wx:key="id" class="task-card {{item.occurrence.status !== 'pending' ? 'is-done' : ''}}"><button class="check-button" disabled="{{writing || (batchMode ? !item.task.capabilities.canShare || !item.task.capabilities.canEdit : !item.occurrence.canRecord)}}" data-id="{{item.occurrence.id}}" bindtap="toggleTask" aria-label="{{item.occurrence.canRecord ? '记录或撤销完成' : '仅可查看'}}"><view class="check-circle"><text wx:if="{{batchMode}}">{{item.selected ? '✓' : ''}}</text><image wx:if="{{!batchMode && item.occurrence.status === 'completed'}}" class="icon" src="/assets/check-green.svg"/><text wx:elif="{{item.occurrence.status === 'skipped'}}">−</text><image wx:elif="{{!item.occurrence.canRecord}}" class="icon" src="/assets/lock.svg"/></view></button><button class="task-main" data-id="{{item.occurrence.id}}" bindtap="openTask"><text class="strong">{{item.task.title}}</text><view class="task-meta"><text class="house-tag {{!item.task.familyId ? 'personal' : ''}}">{{item.task.familyName || '个人事项'}}</text><text>{{item.occurrence.subjectName}} · {{item.occurrence.time || '不限定时刻'}}</text></view><text wx:if="{{item.statusLabel}}" class="record-note">{{item.statusLabel}}</text></button></view></view><view wx:if="{{!visibleItems.length && !error}}" class="state-box"><text class="h4">这一页的事情都完成了</text><text class="paragraph">点击“显示已完成”回看记录。</text></view></view>
    <button wx:if="{{tab === 'today' && backlog.length && status !== 'error'}}" class="backlog" bindtap="openBacklog"><image class="icon tiny" src="/assets/clock.svg"/><text>之前还有 {{backlog.length}} 件未完成</text><image class="icon tiny" src="/assets/chevron.svg"/></button>
    <button wx:if="{{error && status !== 'error'}}" class="text-button" bindtap="retry">{{error}}</button>
    <button wx:if="{{pendingCount}}" class="outline-button full-width" bindtap="retryPending" loading="{{writing}}">有未确认的操作 · 重试确认结果</button><text class="form-error">{{quickError}}</text><text class="form-error">{{batchError}}</text><button wx:if="{{batchResults.length}}" class="text-button" bindtap="showBatchResult">查看批量结果</button><button class="text-button" bindtap="openRecycle">回收站</button><text class="end-note">一家人的小事，一件一件来。</text>
  </view></scroll-view>
  <view class="phone-bottom"><button wx:if="{{batchMode}}" class="primary-button full-width" bindtap="openBatch" disabled="{{!selectedTasks.length}}">批量增加可见人 · {{selectedTasks.length}} / 20 项</button><button wx:else class="primary-button add-button" bindtap="openQuick" disabled="{{!today || saving || writing || uncertain}}"><image class="icon" src="/assets/plus-white.svg"/>记一件事</button></view>
</view>
<view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-header"><text class="h2">{{sheet === 'batch' ? '批量增加可见人' : sheet === 'quick' ? '记一件事' : sheet === 'reminders' ? '到时提醒' : '之前未完成'}}</text><button class="icon-button" bindtap="closeSheet" aria-label="关闭"><image class="icon" src="/assets/close.svg"/></button></view><scroll-view class="sheet-scroll" scroll-y>
  <block wx:if="{{sheet === 'batch'}}"><text class="sheet-message">按家庭分别选择。保留已有可见人，不增加代记或提醒权限。</text><view wx:for="{{batchGroups}}" wx:key="key" class="flow-card"><text class="h3">{{item.name}} · {{item.taskIds.length}} 项</text><picker wx:if="{{item.key === 'personal'}}" range="{{batchFamilyOptions}}" value="{{item.familyIndex}}" bindchange="batchFamilyChange" disabled="{{batchBusy || pendingCount}}"><view class="form-select">先明确归属一个家庭：{{batchFamilyOptions[item.familyIndex]}}</view></picker><text wx:if="{{item.loading}}">正在加载家人…</text><checkbox-group data-key="{{item.key}}" bindchange="batchViewersChange"><label wx:for="{{item.viewers}}" wx:for-item="viewer" wx:key="id" class="checkbox-label"><checkbox value="{{viewer.id}}" checked="{{viewer.checked}}" disabled="{{batchBusy || pendingCount}}"/>{{viewer.name}}</label></checkbox-group><text class="form-error">{{item.error}}</text></view><button wx:if="{{batchGroups.length && !batchResults.length && !pendingCount}}" class="primary-button full-width" bindtap="submitBatch" disabled="{{batchBusy}}" loading="{{batchBusy}}">确认增加可见人</button><view wx:for="{{batchResults}}" wx:key="taskId" class="history-item"><text class="strong">第 {{index + 1}} 项 · {{item.status === 'succeeded' ? '成功' : item.status === 'pending' ? '待确认' : '失败'}}</text><text class="paragraph">{{item.label}}</text></view><button wx:if="{{pendingCount}}" class="primary-button full-width" data-mode="continue" bindtap="submitBatch" disabled="{{batchBusy}}" loading="{{batchBusy}}">继续确认本次批量操作</button><button wx:if="{{batchComplete && batchHasFailures}}" class="outline-button full-width" data-mode="failed" bindtap="submitBatch" disabled="{{batchBusy}}" loading="{{batchBusy}}">仅重试失败项</button><text class="form-error">{{batchError}}</text></block>
  <block wx:elif="{{sheet === 'quick'}}">
    <input class="title-input" value="{{quickTitle}}" maxlength="80" placeholder="想记下什么小事？" bindinput="quickTitleInput" disabled="{{writing || saving || uncertain}}"/>
    <text class="field-label">哪天做</text><view class="form-pills"><button wx:for="{{['today','tomorrow','unscheduled']}}" wx:key="*this" class="{{quickDate === item ? 'active' : ''}}" data-date="{{item}}" bindtap="quickDateChange" disabled="{{writing || saving || uncertain}}">{{item === 'today' ? '今天' : item === 'tomorrow' ? '明天' : '未安排'}}</button></view>
    <view class="privacy-note"><image class="icon" src="/assets/lock.svg"/><text>{{quickNotice}}
不设置具体时刻，也可以保存。</text></view>
    <checkbox-group bindchange="quickReminderChange"><label class="checkbox-label"><checkbox value="enabled" checked="{{quickReminder}}" disabled="{{writing || saving || uncertain}}" color="#5860b5"/>小程序内提醒我</label></checkbox-group><text class="form-helper">默认开启，可手动关闭。设置具体时刻后，到时在小程序内提示。</text>
    <button class="sheet-secondary" bindtap="expand" disabled="{{saving || writing || uncertain}}">家庭、时刻与共享<image class="icon" src="/assets/chevron-brand.svg"/></button>
    <view wx:if="{{expanded}}"><text class="field-label">所属家庭</text><picker range="{{quickFamilyOptions}}" value="{{quickFamilyIndex}}" bindchange="quickFamilyChange" disabled="{{saving || writing || uncertain}}"><view class="form-select">{{quickFamilyOptions[quickFamilyIndex]}}</view></picker><text class="field-label">谁来做</text><picker range="{{quickSubjectNames}}" value="{{quickSubjectIndex}}" bindchange="quickSubjectChange" disabled="{{saving || writing || uncertain || quickLoading}}"><view class="form-select">{{quickSubjectNames[quickSubjectIndex]}}</view></picker><text class="field-label" wx:if="{{quickRows.length}}">增加查看人</text><checkbox-group bindchange="quickViewersChange"><label wx:for="{{quickRows}}" wx:key="membershipId" class="checkbox-label"><checkbox value="{{item.membershipId}}" checked="{{item.canView}}" disabled="{{item.requiredViewer || saving || writing || uncertain}}"/>{{item.name}}{{item.requiredViewer ? " · 必要可见" : ""}}</label></checkbox-group><view class="two-fields"><view><text class="field-label">重复</text><picker range="{{quickRepeatOptions}}" value="{{quickRepeatIndex}}" bindchange="quickRepeatChange" disabled="{{writing || saving || uncertain || quickLoading}}"><view class="form-select">{{quickRepeatOptions[quickRepeatIndex]}}</view></picker></view><view><text class="field-label">时刻（可选）</text><picker mode="time" value="{{quickTime || '09:00'}}" bindchange="quickTimeChange" disabled="{{writing || saving || uncertain || quickDate === 'unscheduled'}}"><view class="form-input">{{quickTime || '不限定时刻'}}</view></picker></view></view><button class="text-button" bindtap="fullEditor" disabled="{{writing || saving || uncertain || quickLoading}}">完整安排 · 每周与多个时刻</button><text class="field-label">备注</text><textarea class="form-input" maxlength="1000" value="{{quickNote}}" bindinput="quickNoteInput" disabled="{{writing || saving || uncertain}}"/><text class="form-helper">增加可见人不会同时开启对方的提醒或代记权限。</text></view>
    <text class="form-error">{{quickError}}</text><button wx:if="{{quickLoading && quickError}}" class="text-button" bindtap="retryQuickFamily" disabled="{{saving || writing || uncertain}}">重新加载家人</button><text wx:if="{{quickSuccess}}" class="sheet-success">{{quickSuccess}}</text><view class="sheet-actions"><button class="outline-button" data-keep="yes" bindtap="saveQuick" disabled="{{saving || quickLoading}}">保存并继续记</button><button class="primary-button" bindtap="saveQuick" loading="{{writing}}" disabled="{{saving || quickLoading}}">{{uncertain ? '重试确认保存' : '保存事项'}}</button></view>
  </block>
  <block wx:elif="{{sheet === 'reminders'}}"><text class="sheet-message">汇总所有家庭中提醒你的事项。
仅在使用小程序时提示，关闭后不会发送微信通知。</text><button class="text-button" bindtap="toggleDismissed">{{includeDismissed ? '隐藏已收起' : '查看已收起'}}</button><button wx:if="{{reminderError}}" class="text-button" bindtap="retry">{{reminderError}}</button><view wx:for="{{reminders}}" wx:key="id" class="reminder-item"><text class="h3">{{item.title}}</text><text class="paragraph">{{item.familyName || "个人事项"}} · {{item.subjectName}} · {{item.occurrence.localDate}} {{item.occurrence.slot}}</text><text wx:if="{{item.dismissedAt}}" class="paragraph">你已收起这条提示，事项仍待完成</text><view class="item-actions"><button class="outline-button" data-id="{{item.occurrence.id}}" bindtap="dismissReminder" disabled="{{writing || item.dismissedAt}}">{{item.dismissedAt ? '已收起' : '收起提示'}}</button><button class="primary-button" data-id="{{item.occurrence.id}}" bindtap="reminderDetail">查看事项</button></view></view><view wx:if="{{!reminders.length && !reminderError}}" class="state-box"><text class="h4">暂时没有待处理的到时提醒</text><text class="paragraph">完成事项后，对应提示会一起撤下。</text></view></block>
  <block wx:else><view wx:for="{{backlog}}" wx:key="id" class="task-card"><button class="check-button" data-id="{{item.occurrence.id}}" bindtap="toggleTask" disabled="{{writing || (batchMode ? !item.task.capabilities.canShare || !item.task.capabilities.canEdit : !item.occurrence.canRecord)}}"><view class="check-circle"></view></button><button class="task-main" data-id="{{item.occurrence.id}}" bindtap="openTask"><text class="strong">{{item.task.title}}</text><view class="task-meta">{{item.occurrence.localDate}} · {{item.occurrence.time || '不限定时刻'}}</view></button></view></block>
</scroll-view></view></view>
