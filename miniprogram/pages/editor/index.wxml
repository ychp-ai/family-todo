<view class="screen"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">安排这件事</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner">
<view wx:if="{{status === 'loading'}}"><view class="skeleton"></view><text class="end-note">正在加载安排…</text></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">暂时未能加载</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="load">重新加载</button></view>
<block wx:else><view class="flow-card"><text class="field-label">事项名称</text><input class="form-input" maxlength="80" value="{{title}}" bindinput="titleInput" disabled="{{saving || uncertain || shareOnly}}" placeholder="想记下什么小事？"/><text class="field-label">备注</text><textarea class="form-input" maxlength="1000" value="{{note}}" bindinput="noteInput" disabled="{{saving || uncertain || shareOnly}}"/></view>
<view class="flow-card"><text class="field-label">所属家庭</text><picker range="{{familyOptions}}" value="{{familyIndex}}" bindchange="familyChange" disabled="{{familyLocked || saving || uncertain}}"><view class="form-select">{{familyOptions[familyIndex]}}</view></picker><text class="field-label">执行对象</text><picker range="{{subjectNames}}" value="{{subjectIndex}}" bindchange="subjectChange" disabled="{{subjectMetadataMissing || scheduleLocked || shareOnly || saving || uncertain}}"><view class="form-select">{{subjectNames[subjectIndex]}}</view></picker><view class="flow-notice">{{notice}}</view><view wx:if="{{subjectMetadataMissing}}" class="flow-notice">管理身份信息需要更新，重新加载后可更换执行对象。<button class="text-button" bindtap="load">重新加载</button></view></view>
<view class="flow-card"><view wx:if="{{scheduleLocked}}" class="flow-notice">已完成或跳过的事项保留原安排；需要新安排时另建事项。<button class="text-button" bindtap="another">另建事项</button></view><text class="field-label">重复安排</text><view class="form-select">不重复</view><text class="field-label">开始 / 计划日期</text><picker mode="date" value="{{date}}" bindchange="dateChange" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}"><view class="form-input">{{date || '未安排'}}</view></picker><button wx:if="{{date}}" class="text-button" bindtap="clearDate" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}">改为未安排</button><text class="field-label">具体时刻</text><view class="time-row"><picker mode="time" value="{{time || '09:00'}}" bindchange="timeChange" disabled="{{scheduleLocked || shareOnly || saving || uncertain || !date}}"><view class="form-input">{{time || '＋ 添加时刻'}}</view></picker><button wx:if="{{time}}" class="icon-button" bindtap="clearTime" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}" aria-label="删除时刻">×</button></view><text class="form-helper">不填时刻即当天安排，不限定时刻。</text></view>
<view class="flow-card"><text class="h3">谁一起照应</text><checkbox-group bindchange="reminderChange"><label class="flow-choice"><checkbox value="enabled" checked="{{remindMe}}" disabled="{{saving || uncertain}}" color="#5860b5"/>提醒我 · 小程序内</label></checkbox-group><text class="form-helper">{{remindMe ? time ? '按具体时刻展示到时提示' : '已开启 · 待设置时刻' : '我的提醒未开启'}}</text><block wx:if="{{rows.length}}"><view class="permission-row header"><text>家人</text><text>查看</text><text>代记</text><text>提醒</text></view><block wx:for="{{rows}}" wx:key="membershipId"><view wx:if="{{!item.isMe || !item.requiredViewer}}" class="permission-row"><text>{{item.name}}{{item.isMe ? ' · 我' : ''}}</text><checkbox-group data-id="{{item.membershipId}}" data-field="view" bindchange="permissionChange"><label><checkbox value="yes" checked="{{item.canView}}" disabled="{{item.requiredViewer || saving || uncertain}}"/></label></checkbox-group><checkbox-group data-id="{{item.membershipId}}" data-field="help" bindchange="permissionChange"><label><checkbox value="yes" checked="{{item.canHelp}}" disabled="{{!item.canView || saving || uncertain}}"/></label></checkbox-group><checkbox-group data-id="{{item.membershipId}}" data-field="reminder" bindchange="permissionChange"><label><checkbox value="yes" checked="{{item.isMe ? remindMe : item.receivesReminder}}" disabled="{{item.isMe || !item.canView || item.reminderSelfDisabled || saving || uncertain}}"/></label></checkbox-group></view><text wx:if="{{!item.isMe && item.reminderSelfDisabled}}" class="form-helper">{{item.name}}已自行关闭提醒，需本人开启。</text></block><text class="form-helper">必要可见人不可取消；执行人本人可记录。增加查看不同时授予代记或提醒。</text></block><view wx:else class="flow-notice">个人事项仅自己可见。</view></view><view class="flow-card"><text class="h3">下一次安排</text><text class="paragraph">{{date || '未安排'}}{{time ? ' ' + time : ' · 不限定时刻'}}</text></view>
<view wx:if="{{conflict}}" class="flow-card"><text class="h3">草稿还在</text><view class="flow-notice">事项刚刚更新了。你的输入已保留，请查看最新内容。</view><button class="outline-button" bindtap="loadLatest">查看最新内容</button><view wx:if="{{latest}}"><text class="paragraph">最新标题：{{latest.title}}</text><text class="paragraph">最新备注：{{latest.note || '无'}}</text><text class="paragraph">最新安排：{{latest.schedule.date || '未安排'}} {{latest.schedule.time || '不限定时刻'}}</text><button class="outline-button" bindtap="keepDraft">保留我的输入并重新核对</button></view></view><text class="flow-error">{{error}}</text></block>
</view></scroll-view><view wx:if="{{status === 'ready'}}" class="phone-bottom"><button class="primary-button full-width" bindtap="save" loading="{{saving}}" disabled="{{saving || conflict}}">{{uncertain ? '重试确认保存' : '保存这份安排'}}</button></view></view>
