<view class="screen"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">安排这件事</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner">
<view wx:if="{{status === 'loading'}}"><view class="skeleton"></view><text class="end-note">正在加载安排…</text></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">暂时未能加载</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="load">重新加载</button></view>
<block wx:else><editor-content title="{{title}}" note="{{note}}" saving="{{saving}}" uncertain="{{uncertain}}" share-only="{{shareOnly}}" bind:action="onComponentAction"/>
<editor-subject roster-loading="{{rosterLoading}}" saving="{{saving}}" uncertain="{{uncertain}}" family-options="{{familyOptions}}" family-index="{{familyIndex}}" family-locked="{{familyLocked}}" subject-names="{{subjectNames}}" subject-index="{{subjectIndex}}" notice="{{notice}}" schedule-locked="{{scheduleLocked}}" subject-metadata-missing="{{subjectMetadataMissing}}" share-only="{{shareOnly}}" bind:action="onComponentAction"/>
<editor-schedule repeat="{{repeat}}" end-date="{{endDate}}" times="{{times}}" locked-skipped="{{lockedSkipped}}" repeat-options="{{repeatOptions}}" repeat-index="{{repeatIndex}}" weekday-rows="{{weekdayRows}}" id="{{id}}" date="{{date}}" time="{{time}}" saving="{{saving}}" uncertain="{{uncertain}}" schedule-locked="{{scheduleLocked}}" share-only="{{shareOnly}}" bind:action="onComponentAction"/>
<editor-permissions repeat="{{repeat}}" times="{{times}}" time="{{time}}" remind-me="{{remindMe}}" saving="{{saving}}" uncertain="{{uncertain}}" rows="{{rows}}" bind:action="onComponentAction"/><editor-preview preview="{{preview}}" preview-explanation="{{previewExplanation}}" preview-loading="{{previewLoading}}" preview-error="{{previewError}}" bind:action="onComponentAction"/>
<editor-conflict wx:if="{{conflict}}" latest="{{latest}}" bind:action="onComponentAction"/><text class="flow-error">{{error}}</text></block>
</view></scroll-view><view wx:if="{{status === 'ready'}}" class="phone-bottom"><button class="primary-button full-width" bindtap="save" loading="{{saving}}" disabled="{{saving || conflict || rosterLoading}}">{{uncertain ? '重试确认保存' : '保存这份安排'}}</button></view></view>
