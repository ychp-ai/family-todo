<view class="screen"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回待办"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">家人进度</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner">
<view class="family-heading"><view><text class="overline">各自忙碌，也彼此照应</text><text class="h3">我的家人</text></view><button class="text-button" bindtap="manage">管理家庭<image class="icon tiny" src="/assets/chevron.svg"/></button></view>
<view class="family-switch"><button wx:for="{{families}}" wx:key="id" class="{{familyId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="familyChange">{{item.name}}</button></view>
<view wx:if="{{familyId}}" class="family-card"><view class="family-card-copy"><text class="paragraph">在一起的每一天</text><text class="h3">{{familyName}}</text><text class="small">{{memberCaption}}</text></view><view class="family-portrait"><view wx:for="{{portraits}}" wx:key="index" class="avatar lavender">{{item}}</view></view></view>
<view wx:if="{{familyId}}" class="section-title"><text class="h4">这一天的安排</text><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="text-button">{{dateLabel || date}}</view></picker></view><picker wx:if="{{filterNames.length}}" range="{{filterNames}}" value="{{subjectIndex}}" bindchange="subjectChange"><view class="form-select">{{filterNames[subjectIndex]}}</view></picker>
<view wx:if="{{loading}}"><view class="skeleton"></view><text class="end-note">正在完整加载家人进度…</text></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">进度暂未完整加载</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="retry">重试</button></view><view wx:elif="{{status === 'empty'}}" class="state-box"><text class="h4">{{familyId ? '暂无共享给你的这一天安排' : '还没有加入家庭'}}</text><text class="paragraph">{{familyId ? '换个日期，看看家人的安排。' : '个人事项仍可照常使用。'}}</text><button wx:if="{{!familyId}}" class="outline-button" bindtap="manage">创建或管理家庭</button></view>
<view wx:for="{{members}}" wx:key="key" class="member-card"><view class="avatar lavender">{{item.initial}}</view><view class="member-copy"><text class="strong">{{item.name}}{{item.subject.kind === 'virtual' ? ' · 家人代记' : ''}}</text><text class="paragraph">{{item.completed}} 件已完成 · {{item.pending}} 件待完成{{item.skipped ? ' · 跳过 ' + item.skipped + ' 件' : ''}}</text></view><view class="member-meter"><image class="meter-image" src="{{item.meter}}"/><text>{{item.completed}}/{{item.denominator}}</text></view></view>
<view class="family-footnote"><image class="icon" src="/assets/lock.svg"/><text class="paragraph">这里只展示家人共享给你的事项。\n没有记录，不代表没有完成。</text></view><button class="outline-button full-width" bindtap="manage">邀请家人一起记</button></view></scroll-view></view>
