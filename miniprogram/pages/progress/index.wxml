<import src="../../templates/loading.wxml"/>
<view class="screen family-flow"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回家庭"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">家人进度</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner">
<view class="family-heading"><view><text class="overline">各自忙碌，也彼此照应</text><text class="h3">家人进度</text></view><button class="text-button" bindtap="manage">管理家庭<image class="icon tiny" src="/assets/chevron.svg"/></button></view>
<progress-family-filter wx:if="{{families.length > 1}}" families="{{families}}" family-id="{{familyId}}" bind:action="onComponentAction"/>
<view wx:if="{{loading && !familyId}}" class="loading-layout" aria-hidden="true"><view class="skeleton loading-cover"></view><view class="skeleton loading-section"></view><view class="skeleton loading-input"></view></view><progress-cover wx:if="{{familyId}}" family-name="{{familyName}}" member-caption="{{memberCaption}}" portraits="{{portraits}}"/>
<view wx:if="{{familyId}}" class="section-title"><text class="h4">这一天的安排</text><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="text-button">{{dateLabel || date}}</view></picker></view><picker class="progress-filter" wx:if="{{familyId && filterNames.length}}" range="{{filterNames}}" value="{{subjectIndex}}" bindchange="subjectChange"><view class="form-select">{{filterNames[subjectIndex]}}</view></picker>
<view wx:if="{{loading}}"><template is="loading-cards" data="{{kind: 'members', label: '正在完整加载家人进度…'}}"/></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">进度暂未完整加载</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="retry">重试</button></view><view wx:elif="{{status === 'empty'}}" class="state-box"><text class="h4">{{familyId ? '暂无共享给你的这一天安排' : '还没有加入家庭'}}</text><text class="paragraph">{{familyId ? '换个日期，看看家人的安排。' : '创建或加入家庭后，查看家人的安排。'}}</text><button wx:if="{{!familyId}}" class="outline-button" bindtap="manage">创建或管理家庭</button></view>
<progress-member wx:for="{{members}}" wx:key="key" item="{{item}}"/>
<view wx:if="{{!loading}}" class="family-footnote"><image class="icon" src="/assets/lock.svg"/><text class="paragraph">这里只展示家人共享给你的事项。\n没有记录，不代表没有完成。</text></view><button wx:if="{{!loading && familyId}}" class="outline-button full-width" bindtap="manage">邀请家人一起记</button></view></scroll-view></view>
