<import src="../../templates/loading.wxml"/>
<view class="screen family-flow family-tab"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button wx:if="{{family || id}}" class="icon-button" bindtap="allFamilies" aria-label="返回家庭列表"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">{{family || id ? '家庭详情' : '家庭'}}</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner">
<family-profile wx:if="{{!family && !id}}" avatar-path="{{avatarPath}}" display-name="{{displayName}}" avatar-initial="{{avatarInitial}}" bind:action="onComponentAction"/>

<view wx:if="{{status === 'loading'}}"><template is="loading-cards" data="{{kind: id ? 'family' : 'list', label: '正在加载家人…'}}"/></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">家庭暂时没有加载出来</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="load">重新加载</button></view>
<block wx:else><block wx:if="{{!family}}"><view wx:if="{{status === 'empty'}}" class="state-box"><image class="icon" src="/assets/people-brand.svg"/><text class="h4">还没有加入家庭</text><text class="paragraph">个人事项仍可照常使用。创建或加入家庭，一起照应日常的小事。</text></view><view class="family-list-heading"><text class="h3">我的家庭</text><text class="small">{{families.length}} 个家庭</text></view><family-row wx:for="{{families}}" wx:key="id" item="{{item}}" bind:action="onComponentAction"/></block>
<block wx:else><view class="flow-card"><text class="h3">{{family.name}}</text><text class="paragraph">拥有人 · {{ownerName}}</text><button wx:if="{{owner}}" class="outline-button" bindtap="renameFamily">修改家庭名称</button></view><text class="flow-section-title">家人 · {{members.length}} 位</text>
<text class="form-helper">今日进度 · {{progressDate}} · 仅统计共享给你的事项</text>
<family-member progress-loading="{{progressLoading}}" progress-error="{{progressError}}" wx:for="{{members}}" wx:key="id" owner="{{owner}}" item="{{item}}" bind:action="onComponentAction"/>
<family-virtual-member progress-loading="{{progressLoading}}" progress-error="{{progressError}}" wx:for="{{virtualMembers}}" wx:key="id" owner="{{owner}}" writing="{{writing}}" uncertain="{{uncertain}}" item="{{item}}" bind:action="onComponentAction"/><view wx:if="{{!virtualMembers.length}}" class="flow-notice">还没有无账号成员，可为没有账号的家人添加称呼。</view>
<button wx:if="{{progressError}}" class="text-button" bindtap="retryProgress">{{progressError}} · 重试进度</button><view class="family-detail-actions"><view wx:if="{{owner}}" class="family-owner-actions"><button class="outline-button" bindtap="addVirtual">添加无账号成员</button><button class="outline-button" bindtap="invite">邀请家人</button><button class="outline-button family-transfer-action" bindtap="startTransfer">转交拥有权</button></view><button class="outline-button full-width family-exit-action" bindtap="startExit">退出这个家庭</button></view></block>
<family-management detail="{{!!family}}" families="{{families}}" bind:action="onComponentAction"/></block>
<text class="form-error">{{error}}</text><button wx:if="{{uncertain}}" class="primary-button full-width" bindtap="retryWrite" loading="{{writing}}">重试确认本次操作</button></view></scroll-view></view>
<!-- Keep closing under page control so pending writes retain their dialog and context. -->
<view wx:if="{{sheet}}" class="family-weui-dialog-host family-flow">
<view class="mask" bindtap="closeSheet" catchtouchmove="noop" aria-role="button" aria-label="关闭弹窗遮罩"></view>
<mp-half-screen-dialog show="{{!!sheet}}" ext-class="family-weui-sheet" closabled="{{false}}" mask="{{false}}" bindclose="closeSheet">
  <view slot="title"><view class="sheet-handle"></view><view class="sheet-header"><text class="h2">{{formTitle}}</text><button class="icon-button" bindtap="closeSheet" aria-label="关闭弹窗">×</button></view></view>
  <scroll-view slot="desc" class="sheet-scroll" scroll-y>
<block wx:if="{{sheet === 'profile'}}"><form bindsubmit="saveProfile"><button class="profile-avatar profile-avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{profileSaving}}" aria-label="选择微信头像"><image wx:if="{{profileAvatar}}" src="{{profileAvatar}}" mode="aspectFill"/><text wx:else>{{avatarInitial || '我'}}</text></button><text class="form-helper profile-avatar-hint">点击选择头像</text><text class="field-label">昵称</text><input class="form-input" type="nickname" name="nickname" maxlength="32" value="{{profileName}}" bindinput="profileNickname" bindblur="profileNickname" bindnicknamereview="nicknameReview" placeholder="填写昵称" disabled="{{profileSaving}}"/><text class="form-error">{{profileError}}</text><button class="primary-button full-width" form-type="submit" loading="{{profileSaving}}" disabled="{{profileSaving}}">保存</button></form></block>
<block wx:elif="{{sheet === 'exit' || sheet === 'transfer'}}"><block wx:if="{{sheet === 'transfer'}}"><text class="field-label">承接人</text><picker range="{{targets}}" range-key="name" value="{{targetIndex}}" bindchange="targetChange" disabled="{{writing || uncertain || previewLoading}}"><view class="form-select">{{targets[targetIndex].name}}</view></picker></block><template wx:if="{{previewLoading}}" is="loading-preview"/><text class="form-error">{{previewError}}</text><block wx:if="{{exit}}"><text class="sheet-message">将 {{exit.ownedTaskCount}} 项普通事项（含 {{exit.privateTaskCount}} 项仅本人可见）及 {{exit.createdManagementCount}} 项创建管理职责交给{{exit.successorName}}。虚拟人事项 {{exit.virtualTaskCount}} 项。历史记录保留；个人及其他家庭不受影响。</text><button class="primary-button full-width" bindtap="confirmExit" disabled="{{writing || uncertain}}">确认交接</button></block><block wx:elif="{{transfer}}"><text class="sheet-message">{{transfer.virtualTaskCount}} 个虚拟人事项的管理归属交给{{transfer.toName}}，历史记录不变。转交后你仍在家庭中，退出需要另行确认。</text><button class="primary-button full-width" bindtap="confirmTransfer" disabled="{{writing || uncertain}}">确认转交</button></block><block wx:elif="{{!previewLoading && !uncertain}}"><button wx:if="{{sheet === 'exit'}}" class="outline-button full-width" bindtap="loadExit">重新查看交接影响</button><button wx:else class="outline-button full-width" bindtap="loadTransfer">重新查看交接影响</button></block></block>
<block wx:elif="{{sheet === 'noSuccessor'}}"><text class="sheet-message">先邀请另一位真实成员加入，再转交拥有权。</text><button class="primary-button full-width" bindtap="invite">查看邀请</button></block>
<block wx:else><text class="field-label">{{sheet === 'create' || sheet === 'family' ? '家庭名称' : '称呼'}}</text><input class="form-input" maxlength="{{sheet === 'create' || sheet === 'family' ? 24 : 12}}" value="{{name}}" bindinput="nameInput" disabled="{{writing || uncertain}}"/><block wx:if="{{sheet === 'create'}}"><text class="field-label">我在家里的称呼</text><input class="form-input" maxlength="12" value="{{myName}}" bindinput="myNameInput" disabled="{{writing || uncertain}}"/></block><text wx:if="{{sheet === 'addVirtual'}}" class="form-helper">没有独立账号，由家庭拥有人管理相关事项。</text><button class="primary-button full-width" bindtap="save" disabled="{{writing || uncertain}}">{{sheet === 'create' ? '创建家庭' : '保存'}}</button></block><text class="form-error">{{error}}</text><button wx:if="{{uncertain}}" class="primary-button full-width" bindtap="retryWrite" loading="{{writing}}">重试确认本次操作</button></scroll-view>
</mp-half-screen-dialog>
</view>
