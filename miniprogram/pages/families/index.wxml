<view class="screen"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">照应彼此的小家</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner">
<view wx:if="{{status === 'loading'}}"><view class="skeleton"></view><text class="end-note">正在加载家人…</text></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">家庭暂时没有加载出来</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="load">重新加载</button></view>
<block wx:else><block wx:if="{{!family}}"><view wx:if="{{status === 'empty'}}" class="state-box"><image class="icon" src="/assets/people-brand.svg"/><text class="h4">还没有加入家庭</text><text class="paragraph">个人事项仍可照常使用。创建或加入家庭，一起照应日常的小事。</text></view><view wx:for="{{families}}" wx:key="id" class="flow-card"><text class="h3">{{item.name}}</text><text class="paragraph">拥有人 · {{item.ownerName}}</text><button class="outline-button" data-id="{{item.id}}" bindtap="select">查看家人</button></view></block>
<block wx:else><button class="text-button" bindtap="allFamilies">全部家庭</button><view class="flow-card"><text class="h3">{{family.name}}</text><text class="paragraph">拥有人 · {{ownerName}}</text><button wx:if="{{owner}}" class="outline-button" bindtap="renameFamily">修改家庭名称</button></view><text class="flow-section-title">家人 · {{members.length}} 位</text>
<view wx:for="{{members}}" wx:key="id" class="flow-card"><text class="h3">{{item.name}}{{item.isMe ? ' · 我' : ''}}</text><text class="paragraph">{{item.role === 'owner' ? '家庭拥有人' : '真实成员'}}</text><view class="flow-inline-actions"><button wx:if="{{owner || item.isMe}}" class="outline-button" data-id="{{item.id}}" bindtap="renameMember">修改称呼</button><button wx:if="{{owner && !item.isMe}}" class="outline-button" data-id="{{item.id}}" bindtap="startExit">移除成员</button></view></view>
<view wx:for="{{virtualMembers}}" wx:key="id" class="flow-card"><text class="h3">{{item.name}} · 无账号成员</text><text class="paragraph">{{item.status === 'active' ? '由当前家庭拥有人管理' : '已停用 · 历史保留'}}</text><view wx:if="{{owner}}" class="flow-inline-actions"><button class="outline-button" data-id="{{item.id}}" bindtap="renameVirtual">修改称呼</button><button wx:if="{{item.status === 'active'}}" class="outline-button" data-id="{{item.id}}" bindtap="deactivate">停用</button></view></view><view wx:if="{{!virtualMembers.length}}" class="flow-notice">还没有无账号成员，可为没有账号的家人添加称呼。</view>
<view wx:if="{{owner}}" class="flow-inline-actions"><button class="outline-button" bindtap="addVirtual">添加无账号成员</button><button class="outline-button" bindtap="invite">邀请家人</button><button class="outline-button" bindtap="startTransfer">转交拥有权</button></view><button class="outline-button full-width" bindtap="startExit">退出这个家庭</button></block>
<view class="flow-inline-actions"><button class="outline-button" bindtap="openCreate">{{families.length ? '创建另一个家庭' : '创建家庭'}}</button><button class="outline-button" bindtap="join">加入家庭</button></view></block>
<text class="form-error">{{error}}</text><button wx:if="{{uncertain}}" class="primary-button full-width" bindtap="retryWrite" loading="{{writing}}">重试确认本次操作</button></view></scroll-view></view>
<view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-header"><text class="h2">{{formTitle}}</text><button class="icon-button" bindtap="closeSheet">×</button></view><scroll-view class="sheet-scroll" scroll-y>
<block wx:if="{{sheet === 'exit' || sheet === 'transfer'}}"><block wx:if="{{sheet === 'transfer'}}"><text class="field-label">承接人</text><picker range="{{targets}}" range-key="name" value="{{targetIndex}}" bindchange="targetChange" disabled="{{writing || uncertain || previewLoading}}"><view class="form-select">{{targets[targetIndex].name}}</view></picker></block><text wx:if="{{previewLoading}}" class="paragraph">正在完整检查交接范围，请稍候…</text><text class="form-error">{{previewError}}</text><block wx:if="{{exit}}"><text class="sheet-message">将 {{exit.ownedTaskCount}} 项普通事项（含 {{exit.privateTaskCount}} 项仅本人可见）及 {{exit.createdManagementCount}} 项创建管理职责交给{{exit.successorName}}。虚拟人事项 {{exit.virtualTaskCount}} 项。历史记录保留；个人及其他家庭不受影响。</text><button class="primary-button full-width" bindtap="confirmExit" disabled="{{writing || uncertain}}">确认交接</button></block><block wx:elif="{{transfer}}"><text class="sheet-message">{{transfer.virtualTaskCount}} 个虚拟人事项的管理归属交给{{transfer.toName}}，历史记录不变。转交后你仍在家庭中，退出需要另行确认。</text><button class="primary-button full-width" bindtap="confirmTransfer" disabled="{{writing || uncertain}}">确认转交</button></block><block wx:elif="{{!previewLoading && !uncertain}}"><button wx:if="{{sheet === 'exit'}}" class="outline-button full-width" bindtap="loadExit">重新查看交接影响</button><button wx:else class="outline-button full-width" bindtap="loadTransfer">重新查看交接影响</button></block></block>
<block wx:elif="{{sheet === 'noSuccessor'}}"><text class="sheet-message">先邀请另一位真实成员加入，再转交拥有权。</text><button class="primary-button full-width" bindtap="invite">查看邀请</button></block>
<block wx:else><text class="field-label">{{sheet === 'create' || sheet === 'family' ? '家庭名称' : '称呼'}}</text><input class="form-input" maxlength="{{sheet === 'create' || sheet === 'family' ? 24 : 12}}" value="{{name}}" bindinput="nameInput" disabled="{{writing || uncertain}}"/><block wx:if="{{sheet === 'create'}}"><text class="field-label">我在家里的称呼</text><input class="form-input" maxlength="12" value="{{myName}}" bindinput="myNameInput" disabled="{{writing || uncertain}}"/></block><text wx:if="{{sheet === 'addVirtual'}}" class="form-helper">没有独立账号，由家庭拥有人管理相关事项。</text><button class="primary-button full-width" bindtap="save" disabled="{{writing || uncertain}}">{{sheet === 'create' ? '创建家庭' : '保存'}}</button></block><text class="form-error">{{error}}</text><button wx:if="{{uncertain}}" class="primary-button full-width" bindtap="retryWrite" loading="{{writing}}">重试确认本次操作</button></scroll-view></view></view>
