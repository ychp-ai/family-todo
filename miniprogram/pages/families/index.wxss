.flow-section-title{display:block;font-size:16px;margin:20px 0 12px}.flow-inline-actions{flex-wrap:wrap}.flow-card .outline-button{margin-top:12px}.sheet .primary-button{margin-top:16px}.flow-card .h3{overflow-wrap:break-word}

.flow-inline-actions button{flex:1 1 120px;min-width:0;white-space:normal;padding:10px 12px}
.flow-card .flow-inline-actions button.outline-button{width:auto;margin-top:0}
.flow-inline-actions+.full-width{margin-top:16px}

.profile-header{display:flex;align-items:center;gap:16px;padding:16px 0 28px}
button.profile-avatar{display:flex;align-items:center;justify-content:center;flex:0 0 64px;width:64px;min-width:64px;max-width:64px;height:64px;line-height:1;border-radius:24px 24px 24px 8px;background:var(--lavender);color:var(--brand);font-family:var(--display);font-size:30px}
.profile-copy{min-width:0}.profile-name{display:block;font-size:22px;font-weight:600;overflow-wrap:anywhere}.profile-copy .paragraph{margin-top:4px;color:var(--muted)}
.family-list-heading{display:flex;align-items:center;justify-content:space-between;margin:4px 0 14px;gap:12px}.family-list-heading .small{color:var(--muted)}
.family-symbol{display:flex;align-items:center;justify-content:center;flex:none;width:40px;height:44px;background:var(--lavender);border-radius:16px 16px 8px 8px}
.family-row-copy{flex:1;min-width:0}.family-row-copy .strong{display:block;font-size:16px;overflow-wrap:anywhere}.family-row-copy .paragraph{margin-top:5px;color:var(--muted);font-size:12px}
.family-tools{margin-top:20px;padding:0 16px;background:var(--paper);border:1px solid var(--line);border-radius:16px}
button.family-tool{display:flex;align-items:center;gap:12px;width:100%;min-height:56px;text-align:left}.family-tool+ .family-tool{border-top:1px solid var(--line)}.family-tool text{flex:1}

.member-heading{display:flex;align-items:center;gap:12px}
.member-heading-copy{flex:1;min-width:0}
button.member-edit{flex:none;border-radius:12px;color:var(--brand)}
.member-edit .icon{width:19px;height:19px}

button.profile-avatar{padding:0;margin:0;overflow:hidden} .profile-avatar image{width:100%;height:100%}
button.profile-name{text-align:left;padding:0;margin:0;min-height:44px;line-height:1.4;display:flex;align-items:center}
button.profile-avatar-picker{margin:8px auto}.profile-avatar-hint{display:block;text-align:center;margin-bottom:20px}

/* 操作区显式分组，避免标题、按钮和卡片外边距叠加。 */
.family-detail-actions{padding-top:4px;display:flex;flex-direction:column;gap:12px}
.family-owner-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.family-owner-actions button{width:100%;min-width:0;margin:0;padding:10px 12px;white-space:normal}
.family-transfer-action{grid-column:1 / -1}
.family-detail-actions button.family-exit-action{margin:0}
.family-management{margin-top:28px}
.family-flow .family-management>.flow-section-title{margin:0 0 12px}
.family-flow .family-management>.flow-inline-actions{margin:0;gap:12px}
.family-management>.family-tools{margin-top:12px}

.member-progress{margin-top:12px;display:flex;align-items:center;gap:12px}

/* WeUI extended-library adapter: keep the existing family card and sheet geometry. */
.family-weui-cells.weui-cells__group { margin:0; }
.family-weui-cells .weui-cells { margin:0; background:transparent; overflow:visible; }
.family-weui-cells .weui-cells::before,
.family-weui-cells .weui-cells::after,
.family-weui-row.weui-cell::before { display:none; }
.family-weui-row.weui-cell {
  display:flex; align-items:center; gap:12px; width:100%; min-height:44px;
  padding:18px 16px; margin-bottom:12px; border-radius:16px;
  background:var(--paper); color:var(--ink); border:1px solid var(--line);
  font:inherit; text-align:left; transition:transform 120ms cubic-bezier(.23,1,.32,1);
}
.family-weui-row .weui-cell__hd { padding:0; margin:0; flex:none; }
.family-weui-row .weui-cell__bd { min-width:0; }
.family-weui-row .weui-cell__ft { padding:0; margin:0; display:flex; flex:none; }
.family-weui-row:active { transform:scale(.98); }
.app-weui-sheet .primary-button { margin-top:16px; }
@media (prefers-reduced-motion:reduce) {
  .family-weui-row.weui-cell { transition:none; }
  .family-weui-row:active { transform:none; }
}
