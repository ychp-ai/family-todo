<import src="../../templates/loading.wxml"/>
<view class="screen family-flow"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">回收站</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner"><recycle-filter wx:if="{{!scopedFamilyId}}" family-options="{{familyOptions}}" family-index="{{familyIndex}}" writing="{{writing}}" bind:action="onComponentAction"/><view wx:if="{{status === 'loading'}}"><template is="loading-cards" data="{{kind: 'recycle', label: '正在加载事项…'}}"/></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">回收站暂时未能加载</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="refresh">重新加载</button></view><view wx:elif="{{status === 'empty'}}" class="state-box"><text class="h4">暂时没有删除的事项</text><text class="paragraph">删除的事项会保留记录，可在这里恢复。</text><button class="outline-button" bindtap="back">返回待办</button></view><block wx:else><recycle-card wx:for="{{items}}" wx:key="id" writing="{{writing && restoringId === item.id}}" item="{{item}}" bind:action="onComponentAction"/><text class="flow-error">{{error}}</text></block></view></scroll-view></view>
