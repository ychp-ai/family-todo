<view class="screen"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">回收站</text></view><scroll-view class="phone-scroll" scroll-y><view class="scroll-inner"><picker range="{{familyOptions}}" value="{{familyIndex}}" bindchange="familyChange" disabled="{{writing}}"><view class="form-select">{{familyOptions[familyIndex]}}</view></picker><view wx:if="{{status === 'loading'}}"><view class="skeleton"></view><text class="end-note">正在加载事项…</text></view><view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">回收站暂时未能加载</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="refresh">重新加载</button></view><view wx:elif="{{status === 'empty'}}" class="state-box"><text class="h4">暂时没有删除的事项</text><text class="paragraph">删除的事项会保留记录，可在这里恢复。</text><button class="outline-button" bindtap="back">返回待办</button></view><block wx:else><view wx:for="{{items}}" wx:key="id" class="flow-card"><text class="h3">{{item.title}}</text><text class="paragraph">{{item.familyName || "个人事项"}} · {{item.subjectName}}
整个事项已删除，历史保留。</text><view class="flow-notice">恢复后保留原来的安排和完成记录。</view><button class="primary-button full-width" data-id="{{item.id}}" bindtap="restore" disabled="{{writing || !item.capabilities.canRestore}}">恢复事项</button></view><text class="flow-error">{{error}}</text></block></view></scroll-view></view>
