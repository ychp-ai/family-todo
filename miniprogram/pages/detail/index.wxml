<view class="screen"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回待办"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">事项详情</text></view>
<scroll-view class="phone-scroll detail-scroll" scroll-y><view class="scroll-inner">
  <view wx:if="{{status === 'loading'}}"><view class="skeleton"></view><text class="end-note">正在加载事项…</text></view>
  <view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">事项暂时没有加载出来</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="retry">重新加载</button></view>
  <block wx:elif="{{task}}"><view class="detail-family"><image class="icon" src="/assets/lock-brand.svg"/>{{task.familyName || "个人事项"}}<text> / </text>{{occurrence ? occurrence.subjectName : task.subjectName}}</view><text class="detail-title">{{task.title}}</text><view class="detail-subtitle"><image class="icon" src="/assets/calendar.svg"/>{{occurrence.localDate || historyDate || '未安排'}} · {{occurrence.time || '不限定时刻'}}</view>
  <detail-completion wx:if="{{occurrence}}" occurrence="{{occurrence}}" completion-label="{{completionLabel}}" recorded-label="{{recordedLabel}}"/>
  <view class="section-title"><text class="h4">这件事的安排</text><text>{{seriesLabel}}</text></view><detail-arrangement has-times="{{hasTimes}}" task="{{task}}" occurrence="{{occurrence}}" viewer-names="{{viewerNames}}" helper-names="{{helperNames}}"/>
  <view wx:if="{{!occurrence.canRecord}}" class="flow-notice">你可以查看这件事和完成记录，暂不能记录这一次。</view><text wx:if="{{task.note}}" class="detail-note">{{task.note}}</text><view class="section-title"><text class="h4">本次记录</text></view><view wx:if="{{!occurrence}}" class="flow-notice">当前没有可显示的次数，可按日期查看历史安排。</view><detail-current-record wx:if="{{occurrence}}" occurrence="{{occurrence}}" completion-label="{{completionLabel}}" recorded-label="{{recordedLabel}}" actual-label="{{actualLabel}}"/><button class="text-button" wx:if="{{occurrence.status === 'pending' && occurrence.canRecord}}" bindtap="openRecord">补记时间 / 跳过这次</button>
  <block wx:if="{{task.schedule.kind !== 'once'}}"><view class="section-title occurrence-section-title"><text class="h4">当前与历史次数</text><picker mode="date" value="{{historyDate}}" bindchange="historyDateChange"><view class="text-button">{{historyDate}} · 选择日期</view></picker></view><text wx:if="{{occurrencesLoading}}" class="paragraph">正在加载次数…</text><view wx:for="{{occurrences}}" wx:key="id" class="occurrence-row"><button class="text-button" data-id="{{item.id}}" bindtap="selectOccurrence">{{item.localDate}} {{item.time || '不限定时刻'}} · {{item.subjectName}} · {{item.status === 'completed' ? '已完成' : item.status === 'skipped' ? '已跳过' : '待完成'}}<image class="icon chevron" src="/assets/chevron.svg"/></button></view><text wx:if="{{!occurrencesLoading && !occurrences.length && !occurrencesError}}" class="paragraph">这一天没有安排。</text><button wx:if="{{occurrencesError}}" class="text-button" bindtap="loadOccurrences">{{occurrencesError}} · 重试</button><view class="section-title"><text class="h4">整个周期</text></view><view class="flow-card"><text class="paragraph">{{seriesLabel}} · 当前执行对象：{{task.subjectName}}</text><text class="paragraph">此前应做和历史保留；暂停期间不补出新记录。</text><button wx:if="{{task.capabilities.canEdit && task.lifecycle === 'active'}}" class="outline-button settings-action" data-action="pause" bindtap="lifecycle" disabled="{{writing}}">暂停周期</button><button wx:if="{{task.capabilities.canResume}}" class="outline-button settings-action" data-action="resume" bindtap="lifecycle" disabled="{{writing}}">继续周期</button><button wx:if="{{task.capabilities.canEdit && (task.lifecycle === 'active' || task.capabilities.canResume)}}" class="outline-button settings-action" data-action="stop" bindtap="lifecycle" disabled="{{writing}}">停止后续</button><text wx:if="{{task.lifecycle === 'stopped' || task.lifecycle === 'paused' && !task.capabilities.canResume}}" class="flow-notice">本系列仅保留历史，不能继续。</text></view></block><view class="section-title"><text class="h4">留下的记录</text></view><view class="history-list"><detail-event wx:for="{{events}}" wx:key="id" item="{{item}}"/></view></block><text wx:if="{{writeError}}" class="form-error">{{writeError}}</text>
</view></scroll-view>
<view wx:if="{{task && status === 'ready'}}" class="phone-bottom"><view class="detail-buttons"><button class="outline-button" bindtap="settings" disabled="{{writing || uncertain}}">事项设置</button><button wx:if="{{occurrence.canRecord}}" class="primary-button {{occurrence.status !== 'pending' ? 'quiet-button' : ''}}" bindtap="complete" disabled="{{writing}}" loading="{{writing}}"><image class="icon" src="{{occurrence.status === 'pending' ? '/assets/check-white.svg' : '/assets/repeat-brand.svg'}}"/>{{uncertain ? '重试确认结果' : occurrence.status === 'pending' ? '记录' + occurrence.subjectName + '完成' : occurrence.status === 'completed' ? '撤销本次完成' : '撤销本次记录'}}</button></view></view></view>
<view wx:if="{{sheet}}">
<view class="mask" bindtap="closeSheet" catchtouchmove="noop" aria-role="button" aria-label="关闭弹窗遮罩"></view>
<mp-half-screen-dialog show="{{!!sheet}}" ext-class="app-weui-sheet" closabled="{{false}}" mask="{{false}}" bindclose="closeSheet">
<view slot="title"><view class="sheet-handle"></view><view class="sheet-header"><text class="h2">{{sheet === 'record' ? '这一次' : '事项设置'}}</text><button class="icon-button" bindtap="closeSheet" aria-label="关闭弹窗"><image class="icon" src="/assets/close.svg"/></button></view></view><scroll-view slot="desc" class="sheet-scroll" scroll-y>
<detail-settings wx:if="{{sheet === 'settings'}}" task="{{task}}" writing="{{writing}}" bind:action="onComponentAction"/>
<block wx:else><view class="flow-card"><text class="h3">{{completionLabel}}</text><text class="paragraph">可以补记实际完成时间。</text><view class="two-fields"><view><text class="field-label">实际完成日期</text><picker mode="date" value="{{recordDate}}" bindchange="recordDateChange" disabled="{{writing || uncertain}}"><view class="form-input">{{recordDate}}</view></picker></view><view><text class="field-label">时刻</text><picker mode="time" value="{{recordTime}}" bindchange="recordTimeChange" disabled="{{writing || uncertain}}"><view class="form-input">{{recordTime}}</view></picker></view></view><text class="field-label">备注</text><textarea class="form-input" maxlength="1000" value="{{recordNote}}" bindinput="recordNoteInput" disabled="{{writing || uncertain}}"/><view class="flow-inline-actions"><button class="primary-button" data-status="completed" bindtap="record" disabled="{{writing}}">保存完成记录</button><button class="outline-button" data-status="skipped" bindtap="record" disabled="{{writing || uncertain}}">跳过这次</button></view></view></block><text class="form-error">{{writeError}}</text></scroll-view></mp-half-screen-dialog></view>
