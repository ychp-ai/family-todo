<view class="screen"><view class="status-space" style="height:{{statusHeight}}px"></view><view class="appbar" style="height:{{navHeight}}px;padding-right:{{capsuleWidth}}px"><button class="icon-button" bindtap="back" aria-label="返回待办"><image class="icon" src="/assets/back.svg"/></button><text class="appbar-title">事项详情</text></view>
<scroll-view class="phone-scroll detail-scroll" scroll-y><view class="scroll-inner">
  <view wx:if="{{status === 'loading'}}"><view class="skeleton"></view><text class="end-note">正在加载事项…</text></view>
  <view wx:elif="{{status === 'error'}}" class="state-box"><text class="h4">事项暂时没有加载出来</text><text class="paragraph">{{error}}</text><button class="outline-button" bindtap="retry">重新加载</button></view>
  <block wx:elif="{{task}}"><view class="detail-family"><image class="icon" src="/assets/lock-brand.svg"/>{{task.familyName || "个人事项"}}<text> / </text>{{occurrence ? occurrence.subjectName : task.subjectName}}</view><text class="detail-title">{{task.title}}</text><view class="detail-subtitle"><image class="icon" src="/assets/calendar.svg"/>{{occurrence.localDate || historyDate || '未安排'}} · {{occurrence.time || '不限定时刻'}}</view>
  <view wx:if="{{occurrence}}" class="completion-card {{occurrence.status === 'pending' ? 'pending' : ''}}"><view class="completion-badge"><image class="icon" src="{{occurrence.status === 'completed' ? '/assets/check-green.svg' : '/assets/clock-brand.svg'}}"/></view><view class="completion-copy"><text class="strong">{{completionLabel}}</text><text class="paragraph">{{occurrence.status === 'pending' ? '没有记录，不代表没有完成' : '由' + occurrence.operatorName + '记录 · ' + recordedLabel}}</text></view></view>
  <view class="section-title"><text class="h4">这件事的安排</text><text>{{seriesLabel}}</text></view><view class="detail-info"><view class="info-row"><text class="info-label">谁来做</text><view class="info-value"><view class="avatar lavender">{{occurrence ? occurrence.subjectName : task.subjectName}}</view>{{occurrence ? occurrence.subjectName : task.subjectName}}{{occurrence.subject.kind === "virtual" ? " · 无账号成员" : ""}}</view></view><view class="info-row"><text class="info-label">由谁管理</text><text class="info-value">{{task.ownerName}}{{task.familyId ? " · 有效创建者也可管理" : ""}}</text></view><view class="info-row"><text class="info-label">谁可以看</text><view class="info-value"><image class="icon tiny" src="/assets/lock.svg"/>{{viewerNames}}</view></view><view class="info-row"><text class="info-label">可代记家人</text><text class="info-value">{{helperNames}}</text></view><view class="info-row"><text class="info-label">小程序内提醒</text><text class="info-value">{{task.myReminder.enabled ? hasTimes ? '我 · 到时提醒' : '已开启 · 待设置时刻' : '未开启'}}</text></view></view>
  <view wx:if="{{!occurrence.canRecord}}" class="flow-notice">你可以查看这件事和完成记录，暂不能代记完成。</view><text wx:if="{{task.note}}" class="detail-note">{{task.note}}</text><view class="section-title"><text class="h4">本次记录</text></view><view wx:if="{{!occurrence}}" class="flow-notice">当前没有可显示的次数，可按日期查看历史安排。</view><view wx:if="{{occurrence}}" class="history-list"><view class="history-item"><text class="strong">{{occurrence.status === 'pending' ? '尚未确认完成' : occurrence.operatorName + '记录' + completionLabel}}</text><text class="paragraph">{{occurrence.status === 'pending' ? '完成后，会在这里留下记录人和时间。' : (actualLabel ? '实际完成：' + actualLabel + ' · ' : '') + '记录时间：' + recordedLabel}}</text></view></view><button class="text-button" wx:if="{{occurrence.status === 'pending' && occurrence.canRecord}}" bindtap="openRecord">补记时间 / 跳过这次</button>
  <block wx:if="{{task.schedule.kind !== 'once'}}"><view class="section-title"><text class="h4">当前与历史次数</text><picker mode="date" value="{{historyDate}}" bindchange="historyDateChange"><view class="text-button">{{historyDate}} · 选择日期</view></picker></view><text wx:if="{{occurrencesLoading}}" class="paragraph">正在加载次数…</text><view wx:for="{{occurrences}}" wx:key="id" class="history-item"><button class="text-button" data-id="{{item.id}}" bindtap="selectOccurrence">{{item.localDate}} {{item.time || '不限定时刻'}} · {{item.subjectName}} · {{item.status === 'completed' ? '已完成' : item.status === 'skipped' ? '已跳过' : '待完成'}}</button></view><text wx:if="{{!occurrencesLoading && !occurrences.length && !occurrencesError}}" class="paragraph">这一天没有安排。</text><button wx:if="{{occurrencesError}}" class="text-button" bindtap="loadOccurrences">{{occurrencesError}} · 重试</button><view class="section-title"><text class="h4">整个周期</text></view><view class="flow-card"><text class="paragraph">{{seriesLabel}} · 当前执行对象：{{task.subjectName}}</text><text class="paragraph">此前应做和历史保留；暂停期间不补出新记录。</text><button wx:if="{{task.capabilities.canEdit && task.lifecycle === 'active'}}" class="outline-button settings-action" data-action="pause" bindtap="lifecycle" disabled="{{writing}}">暂停周期</button><button wx:if="{{task.capabilities.canResume}}" class="outline-button settings-action" data-action="resume" bindtap="lifecycle" disabled="{{writing}}">继续周期</button><button wx:if="{{task.capabilities.canEdit && (task.lifecycle === 'active' || task.capabilities.canResume)}}" class="outline-button settings-action" data-action="stop" bindtap="lifecycle" disabled="{{writing}}">停止后续</button><text wx:if="{{task.lifecycle === 'stopped' || task.lifecycle === 'paused' && !task.capabilities.canResume}}" class="flow-notice">本系列仅保留历史，不能继续。</text></view></block><view class="section-title"><text class="h4">留下的记录</text></view><view class="history-list"><view wx:for="{{events}}" wx:key="id" class="history-item"><text class="strong">{{item.label}} · {{item.actorName}}</text><text class="paragraph">记录于 {{item.recordedLabel}}{{item.actualLabel ? ' · 实际 ' + item.actualLabel : ''}}</text><text wx:if="{{item.note}}" class="paragraph">{{item.note}}</text></view></view></block><text wx:if="{{writeError}}" class="form-error">{{writeError}}</text>
</view></scroll-view>
<view wx:if="{{task && status === 'ready'}}" class="phone-bottom"><view class="detail-buttons"><button class="outline-button" bindtap="settings" disabled="{{writing || uncertain}}">事项设置</button><button wx:if="{{occurrence.canRecord}}" class="primary-button {{occurrence.status !== 'pending' ? 'quiet-button' : ''}}" bindtap="complete" disabled="{{writing}}" loading="{{writing}}"><image class="icon" src="{{occurrence.status === 'pending' ? '/assets/check-white.svg' : '/assets/repeat-brand.svg'}}"/>{{uncertain ? '重试确认结果' : occurrence.status === 'pending' ? '完成本次' : occurrence.status === 'completed' ? '撤销本次完成' : '撤销本次记录'}}</button></view></view></view>
<view wx:if="{{sheet}}" class="mask" bindtap="closeSheet"><view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-header"><text class="h2">{{sheet === 'record' ? '这一次' : '事项设置'}}</text><button class="icon-button" bindtap="closeSheet"><image class="icon" src="/assets/close.svg"/></button></view><scroll-view class="sheet-scroll" scroll-y>
<block wx:if="{{sheet === 'settings'}}"><text class="sheet-message">{{task.title}} · {{task.familyName || "个人事项"}}</text><button wx:if="{{task.capabilities.canEdit}}" class="outline-button full-width settings-action" bindtap="edit">编辑这份安排</button><button class="outline-button full-width settings-action" bindtap="toggleReminder" disabled="{{writing}}">{{task.myReminder.enabled ? '关闭我的提醒' : '开启我的提醒'}}</button><button wx:if="{{task.capabilities.canDelete}}" class="outline-button full-width flow-danger settings-action" bindtap="deleteTask" disabled="{{writing}}">删除整个事项</button><button wx:if="{{task.capabilities.canShare}}" class="outline-button full-width settings-action" bindtap="share">共享这件事</button><button class="text-button" bindtap="recycle">回收站</button></block>
<block wx:else><view class="flow-card"><text class="h3">{{completionLabel}}</text><text class="paragraph">可以补记实际完成时间。</text><view class="two-fields"><view><text class="field-label">实际完成日期</text><picker mode="date" value="{{recordDate}}" bindchange="recordDateChange" disabled="{{writing || uncertain}}"><view class="form-input">{{recordDate}}</view></picker></view><view><text class="field-label">时刻</text><picker mode="time" value="{{recordTime}}" bindchange="recordTimeChange" disabled="{{writing || uncertain}}"><view class="form-input">{{recordTime}}</view></picker></view></view><text class="field-label">备注</text><textarea class="form-input" maxlength="1000" value="{{recordNote}}" bindinput="recordNoteInput" disabled="{{writing || uncertain}}"/><view class="flow-inline-actions"><button class="primary-button" data-status="completed" bindtap="record" disabled="{{writing}}">保存完成记录</button><button class="outline-button" data-status="skipped" bindtap="record" disabled="{{writing || uncertain}}">跳过这次</button></view></view></block><text class="form-error">{{writeError}}</text></scroll-view></view></view>
