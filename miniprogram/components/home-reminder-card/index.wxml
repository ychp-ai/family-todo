<view class="reminder-item"><text class="h3">{{item.title}}</text><text class="paragraph">{{item.familyName || "个人事项"}} · {{item.subjectName}} · {{item.occurrence.localDate}} {{item.occurrence.slot}}</text><text wx:if="{{item.dismissedAt}}" class="paragraph">你已收起这条提示，事项仍待完成</text><view class="item-actions"><button class="outline-button" data-id="{{item.occurrence.id}}" bindtap="dismissReminder" disabled="{{writing || item.dismissedAt}}">{{item.dismissedAt ? '已收起' : '收起提示'}}</button><button class="primary-button" data-id="{{item.occurrence.id}}" bindtap="reminderDetail">查看事项</button></view></view>
