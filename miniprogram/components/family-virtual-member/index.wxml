<view class="flow-card"><view class="member-heading"><view class="member-heading-copy"><text class="h3">{{item.name}} · 无账号成员</text><text class="paragraph">{{item.status === 'active' ? '由当前家庭拥有人管理' : '已停用 · 历史保留'}}</text></view><member-progress-ring wx:if="{{!progressError && (!progressLoading || item.progress)}}" completed="{{item.progress ? item.progress.completed : 0}}" total="{{item.progress ? item.progress.denominator : 0}}"/><button wx:if="{{owner}}" class="text-button member-manage" bindtap="toggleManagement">{{managing ? '收起' : '管理'}}</button></view><view wx:if="{{progressError || !item.progress}}" class="member-progress"><text wx:if="{{progressLoading}}" class="paragraph">正在加载今日进度…</text><text wx:elif="{{progressError}}" class="paragraph">今日进度暂未加载</text><text wx:else class="paragraph">今日暂无共享给你的安排</text></view><view wx:if="{{managing && (owner)}}" class="flow-inline-actions"><button class="outline-button" data-id="{{item.id}}" bindtap="renameVirtual">修改称呼</button><button wx:if="{{item.status === 'active'}}" class="outline-button flow-danger" data-id="{{item.id}}" bindtap="deleteVirtual" disabled="{{writing || uncertain}}">删除成员</button></view></view>
