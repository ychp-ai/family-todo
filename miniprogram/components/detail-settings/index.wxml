<block><text class="sheet-message">{{task.title}} · {{task.familyName || "个人事项"}}</text><button wx:if="{{task.capabilities.canEdit}}" class="outline-button full-width settings-action" bindtap="edit">编辑这份安排</button><button class="outline-button full-width settings-action" bindtap="toggleReminder" disabled="{{writing}}">{{task.myReminder.enabled ? '关闭我的提醒' : '开启我的提醒'}}</button><button wx:if="{{task.capabilities.canDelete}}" class="outline-button full-width flow-danger settings-action" bindtap="deleteTask" disabled="{{writing}}">删除整个事项</button><button wx:if="{{task.capabilities.canShare}}" class="outline-button full-width settings-action" bindtap="share">共享这件事</button><button class="text-button" bindtap="recycle">回收站</button></block>
