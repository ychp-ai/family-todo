<view class="date-tabs"><button class="{{tab === 'today' ? 'active' : ''}}" data-tab="today" bindtap="changeTab">今天</button><button class="{{tab === 'tomorrow' ? 'active' : ''}}" data-tab="tomorrow" bindtap="changeTab">明天</button><button class="{{tab === 'unscheduled' ? 'active' : ''}}" data-tab="unscheduled" bindtap="changeTab">未安排</button><picker mode="date" value="{{selectedDate || today}}" bindchange="pickDate"><button class="calendar-button {{tab === 'calendar' ? 'active' : ''}}" aria-label="选择其他日期"><image class="icon" src="/assets/calendar.svg"/></button></picker></view>
