<view class="flow-card"><text class="h3">{{item.name}} · {{item.taskIds.length}} 项</text><picker wx:if="{{item.key === 'personal'}}" range="{{batchFamilyOptions}}" value="{{item.familyIndex}}" bindchange="batchFamilyChange" disabled="{{batchBusy || pendingCount}}"><view class="form-select">先明确归属一个家庭：{{batchFamilyOptions[item.familyIndex]}}</view></picker><text wx:if="{{item.loading}}">正在加载家人…</text><checkbox-group data-key="{{item.key}}" bindchange="batchViewersChange"><label wx:for="{{item.viewers}}" wx:for-item="viewer" wx:key="id" class="checkbox-label"><checkbox value="{{viewer.id}}" checked="{{viewer.checked}}" disabled="{{batchBusy || pendingCount}}"/>{{viewer.name}}</label></checkbox-group><text class="form-error">{{item.error}}</text></view>
