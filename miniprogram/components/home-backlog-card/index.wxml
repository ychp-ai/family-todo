<view class="task-card"><button class="check-button" data-id="{{item.occurrence.id}}" bindtap="toggleTask" disabled="{{writing || (batchMode ? !item.task.capabilities.canShare || !item.task.capabilities.canEdit : !item.occurrence.canRecord)}}"><view class="check-circle"></view></button><button class="task-main" data-id="{{item.occurrence.id}}" bindtap="openTask"><text class="strong">{{item.task.title}}</text><view class="task-meta"><text>{{item.occurrence.localDate}} · {{item.occurrence.time || '不限定时刻'}}</text><view wx:if="{{item.warningLabel}}" class="task-warning"><image class="task-warning-icon" src="/assets/clock-warning.svg"/><text>{{item.warningLabel}}</text></view></view></button></view>
