<view class="task-card"><button class="check-button" data-id="{{item.occurrence.id}}" bindtap="toggleTask" disabled="{{writing || (batchMode ? !item.task.capabilities.canShare || !item.task.capabilities.canEdit : !item.occurrence.canRecord)}}"><view class="check-circle"></view></button><button class="task-main" data-id="{{item.occurrence.id}}" bindtap="openTask"><text class="strong">{{item.task.title}}</text><view class="task-meta">{{item.occurrence.localDate}} · {{item.occurrence.time || '不限定时刻'}}</view></button></view>
