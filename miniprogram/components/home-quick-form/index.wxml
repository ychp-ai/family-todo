<block>
    <input class="title-input" focus="{{true}}" value="{{quickTitle}}" maxlength="80" placeholder="想记下什么小事？" bindinput="quickTitleInput" disabled="{{writing || saving || uncertain}}"/>
    <text class="field-label">哪天做</text><view class="form-pills"><button wx:for="{{['today','tomorrow','unscheduled']}}" wx:key="*this" class="{{quickDate === item ? 'active' : ''}}" data-date="{{item}}" bindtap="quickDateChange" disabled="{{writing || saving || uncertain}}">{{item === 'today' ? '今天' : item === 'tomorrow' ? '明天' : '未安排'}}</button></view>
    <view class="privacy-note"><image class="icon" src="/assets/lock.svg"/><text>{{quickNotice}}
不设置具体时刻，也可以保存。</text></view>
    <text class="field-label">所属家庭</text><picker range="{{quickFamilyOptions}}" value="{{quickFamilyIndex}}" bindchange="quickFamilyChange" disabled="{{saving || writing || uncertain}}"><view class="form-select">{{quickFamilyOptions[quickFamilyIndex]}}</view></picker>
    <button class="sheet-secondary" bindtap="fullEditor" disabled="{{writing || saving || uncertain || quickLoading}}">更多安排 · 家人、时间与照应<image class="icon" src="/assets/chevron-brand.svg"/></button>
    <text class="form-error">{{quickError}}</text><button wx:if="{{quickLoading && quickError}}" class="text-button" bindtap="retryQuickFamily" disabled="{{saving || writing || uncertain}}">重新加载家人</button><text wx:if="{{quickSuccess}}" class="sheet-success">{{quickSuccess}}</text><view class="sheet-actions"><button class="outline-button" data-keep="yes" bindtap="saveQuick" disabled="{{saving || quickLoading || submitBusy}}">保存，再记一件</button><button class="primary-button" bindtap="saveQuick" loading="{{writing}}" disabled="{{saving || quickLoading || submitBusy}}">{{uncertain ? '重试确认保存' : '保存事项'}}</button></view>
  </block>
