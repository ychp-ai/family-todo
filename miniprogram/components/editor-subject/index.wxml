<view class="flow-card"><text class="field-label">所属家庭</text><picker range="{{familyOptions}}" value="{{familyIndex}}" bindchange="familyChange" disabled="{{rosterLoading || familyLocked || saving || uncertain}}"><view class="form-select">{{familyOptions[familyIndex]}}</view></picker><text class="field-label">执行对象</text><picker range="{{subjectNames}}" value="{{subjectIndex}}" bindchange="subjectChange" disabled="{{rosterLoading || subjectMetadataMissing || scheduleLocked || shareOnly || saving || uncertain}}"><view class="form-select">{{subjectNames[subjectIndex]}}</view></picker><view class="flow-notice">{{notice}}</view><view wx:if="{{subjectMetadataMissing}}" class="flow-notice">管理身份信息需要更新，重新加载后可更换执行对象。<button class="text-button" bindtap="load">重新加载</button></view></view>
