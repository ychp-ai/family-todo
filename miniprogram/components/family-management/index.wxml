<view class="family-management"><text class="flow-section-title">家庭管理</text><view wx:if="{{!detail}}" class="flow-inline-actions"><button class="outline-button" bindtap="openCreate">{{families.length ? '创建另一个家庭' : '创建家庭'}}</button><button class="outline-button" bindtap="join">加入家庭</button></view><view class="family-tools"><mp-cells ext-class="app-weui-cells"><mp-cell wx:if="{{!detail}}" ext-class="app-weui-tool" bindtap="progress" aria-role="button" aria-label="家人进度"><image slot="icon" class="icon" src="/assets/people-brand.svg"/><text>家人进度</text><image slot="footer" class="icon" src="/assets/chevron.svg"/></mp-cell><mp-cell ext-class="app-weui-tool {{!detail ? 'app-weui-tool-divider' : ''}}" bindtap="recycle" aria-role="button" aria-label="回收站"><image slot="icon" class="icon" src="/assets/trash-brand.svg"/><text>回收站</text><image slot="footer" class="icon" src="/assets/chevron.svg"/></mp-cell></mp-cells></view></view>
