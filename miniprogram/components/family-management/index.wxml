<view class="family-management"><text class="flow-section-title">家庭管理</text><view wx:if="{{!detail}}" class="flow-inline-actions"><button class="outline-button" bindtap="openCreate">{{families.length ? '创建另一个家庭' : '创建家庭'}}</button><button class="outline-button" bindtap="join">加入家庭</button></view><view class="family-tools"><button wx:if="{{!detail}}" class="family-tool" bindtap="progress"><image class="icon" src="/assets/people-brand.svg"/><text>家人进度</text><image class="icon" src="/assets/chevron.svg"/></button><button class="family-tool" bindtap="recycle"><image class="icon" src="/assets/trash-brand.svg"/><text>回收站</text><image class="icon" src="/assets/chevron.svg"/></button></view></view>
