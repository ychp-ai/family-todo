.state-card {
  padding: 64rpx 40rpx;
  background: var(--color-surface, #fff);
  border-radius: var(--radius-card, 24rpx);
  text-align: center;
}

.state-title {
  color: var(--color-text-primary, #292735);
  font-size: 36rpx;
  font-weight: 600;
}

.state-description {
  margin-top: 16rpx;
  color: var(--color-text-secondary, #5e5a69);
  font-size: 28rpx;
  line-height: 1.6;
}

.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  min-height: 44px;
  margin-top: 32rpx;
  border-radius: var(--radius-control, 16rpx);
  background: var(--color-brand, #5860b5);
  color: #fff;
  font-size: 28rpx;
}

.retry-button::after { border: 0; }
