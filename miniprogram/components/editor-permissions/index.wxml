<view class="flow-card"><text class="h3">谁一起照应</text><checkbox-group bindchange="reminderChange"><label class="flow-choice"><checkbox value="enabled" checked="{{remindMe}}" disabled="{{saving || uncertain}}" color="#5059ad"/>提醒我 · 小程序内</label></checkbox-group><text class="form-helper">{{remindMe ? (repeat === 'once' ? time : times.length) ? '按具体时刻展示到时提示' : '已开启 · 待设置时刻' : '我的提醒未开启'}}</text>
<block wx:for="{{rows}}" wx:key="membershipId"><view wx:if="{{!item.isMe || !item.requiredViewer}}" class="permission-person"><text class="permission-name">{{item.name}}{{item.isMe ? ' · 我' : ''}}</text><text wx:if="{{item.requiredViewer}}" class="form-helper">必要可见人 · 执行对象或管理人</text><checkbox-group wx:else data-id="{{item.membershipId}}" data-field="view" bindchange="permissionChange"><label class="flow-choice"><checkbox value="yes" checked="{{item.canView}}" disabled="{{saving || uncertain}}" color="#5059ad"/>可以查看</label></checkbox-group><view wx:if="{{item.canView}}" class="permission-subchoices"><checkbox-group data-id="{{item.membershipId}}" data-field="help" bindchange="permissionChange"><label class="flow-choice"><checkbox value="yes" checked="{{item.canHelp}}" disabled="{{saving || uncertain}}" color="#5059ad"/>允许代记完成</label></checkbox-group><checkbox-group wx:if="{{!item.isMe}}" data-id="{{item.membershipId}}" data-field="reminder" bindchange="permissionChange"><label class="flow-choice"><checkbox value="yes" checked="{{item.receivesReminder}}" disabled="{{item.reminderSelfDisabled || saving || uncertain}}" color="#5059ad"/>接收小程序内提醒</label></checkbox-group><text wx:if="{{!item.isMe && item.reminderSelfDisabled}}" class="form-helper">{{item.name}}已自行关闭提醒，需本人开启。</text></view></view></block><text class="form-helper">执行人本人可记录。增加查看不同时授予代记或提醒。</text></view>
