<view class="flow-card"><text class="h3">谁一起照应</text><checkbox-group bindchange="reminderChange"><label class="flow-choice"><checkbox value="enabled" checked="{{remindMe}}" disabled="{{saving || uncertain}}" color="#5860b5"/>提醒我 · 小程序内</label></checkbox-group><text class="form-helper">{{remindMe ? (repeat === 'once' ? time : times.length) ? '按具体时刻展示到时提示' : '已开启 · 待设置时刻' : '我的提醒未开启'}}</text><block wx:if="{{rows.length}}"><view class="permission-row header"><text>家人</text><text>查看</text><text>代记</text><text>提醒</text></view><block wx:for="{{rows}}" wx:key="membershipId"><view wx:if="{{!item.isMe || !item.requiredViewer}}" class="permission-row"><text>{{item.name}}{{item.isMe ? ' · 我' : ''}}</text><checkbox-group data-id="{{item.membershipId}}" data-field="view" bindchange="permissionChange"><label><checkbox value="yes" checked="{{item.canView}}" disabled="{{item.requiredViewer || saving || uncertain}}"/></label></checkbox-group><checkbox-group data-id="{{item.membershipId}}" data-field="help" bindchange="permissionChange"><label><checkbox value="yes" checked="{{item.canHelp}}" disabled="{{!item.canView || saving || uncertain}}"/></label></checkbox-group><checkbox-group data-id="{{item.membershipId}}" data-field="reminder" bindchange="permissionChange"><label><checkbox value="yes" checked="{{item.isMe ? remindMe : item.receivesReminder}}" disabled="{{item.isMe || !item.canView || item.reminderSelfDisabled || saving || uncertain}}"/></label></checkbox-group></view><text wx:if="{{!item.isMe && item.reminderSelfDisabled}}" class="form-helper">{{item.name}}已自行关闭提醒，需本人开启。</text></block><text class="form-helper">必要可见人不可取消；执行人本人可记录。增加查看不同时授予代记或提醒。</text></block><view wx:else class="flow-notice">个人事项仅自己可见。</view></view>
