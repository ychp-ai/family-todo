<view class="member-card"><view class="avatar lavender">{{item.initial}}</view><view class="member-copy"><text class="strong">{{item.name}}{{item.subject.kind === 'virtual' ? ' · 家人代记' : ''}}</text><text class="paragraph">{{item.completed}} 件已完成 · {{item.pending}} 件待完成{{item.skipped ? ' · 跳过 ' + item.skipped + ' 件' : ''}}</text></view><view class="member-meter"><image class="meter-image" src="{{item.meter}}"/><text>{{item.completed}}/{{item.denominator}}</text></view></view>
