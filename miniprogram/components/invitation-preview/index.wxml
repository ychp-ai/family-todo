<view class="flow-card"><text class="h3">{{preview.alreadyJoined ? '你已加入这个家庭' : '一起照应日常的小事'}}</text><text class="paragraph">{{preview.inviterName}}邀请你加入「{{preview.familyName}}」。接受后成为普通成员。</text><text class="paragraph">有效至 {{expiresLabel}}</text><text class="field-label">在家里的称呼</text><input class="form-input" value="{{myName}}" maxlength="12" bindinput="nameInput" disabled="{{writing || uncertain}}"/><button class="primary-button full-width" bindtap="accept" disabled="{{writing || uncertain}}">{{preview.alreadyJoined ? '确认已加入并查看家庭' : '接受邀请并加入'}}</button></view>
