<view class="completion-card {{occurrence.status === 'pending' ? 'pending' : ''}}"><view class="completion-badge"><image class="icon" src="{{occurrence.status === 'completed' ? '/assets/check-green.svg' : '/assets/clock-brand.svg'}}"/></view><view class="completion-copy"><text class="strong">{{completionLabel}}</text><text class="paragraph">{{occurrence.status === 'pending' ? '没有记录，不代表没有完成' : '由' + occurrence.operatorName + '记录 · ' + recordedLabel}}</text></view></view>
