<view class="flow-card"><view wx:if="{{scheduleLocked}}" class="flow-notice">{{lockedSkipped ? '已跳过的事项需先撤销跳过，再调整安排。' : '已完成的一次性事项保留原安排；需要新安排时另建事项。'}}<button class="text-button" bindtap="another">另建事项</button></view><text class="field-label">重复安排</text><view class="repeat-segments"><button wx:for="{{repeatOptions}}" wx:key="index" class="repeat-segment {{repeatIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectRepeat" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}">{{item}}</button></view><view wx:if="{{id && repeat !== 'once'}}" class="flow-notice">仅影响未来安排，过去记录保留；更换执行对象不改历史各次。</view><text class="field-label">开始 / 计划日期</text><picker mode="date" value="{{date}}" bindchange="dateChange" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}"><view class="form-input">{{date || '未安排'}}</view></picker><button wx:if="{{date && repeat === 'once'}}" class="text-button" bindtap="clearDate" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}">改为未安排</button><block wx:if="{{repeat !== 'once'}}"><text class="field-label">结束日期（可选）</text><picker mode="date" value="{{endDate}}" bindchange="endDateChange" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}"><view class="form-input">{{endDate || '不设结束日期'}}</view></picker><button wx:if="{{endDate}}" class="text-button" bindtap="clearEndDate">清除结束日期</button><checkbox-group wx:if="{{repeat === 'weekly'}}" bindchange="weekdaysChange" class="weekdays"><label wx:for="{{weekdayRows}}" wx:key="value" class="checkbox-label"><checkbox value="{{item.value}}" checked="{{item.checked}}" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}"/>{{item.label}}</label></checkbox-group><text class="field-label">具体时刻</text><view wx:for="{{times}}" wx:key="index" class="time-row"><picker mode="time" value="{{item || '09:00'}}" data-index="{{index}}" bindchange="slotChange" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}"><view class="form-input">{{item || '选择时刻'}}</view></picker><button class="icon-button" data-index="{{index}}" bindtap="removeTime" aria-label="删除时刻">×</button></view><button class="text-button" bindtap="addTime" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}">＋ 添加时刻（最多 6 个）</button></block><text wx:if="{{repeat === 'once'}}" class="field-label">具体时刻</text><view wx:if="{{repeat === 'once'}}" class="time-row"><picker mode="time" value="{{time || '09:00'}}" bindchange="timeChange" disabled="{{scheduleLocked || shareOnly || saving || uncertain || !date}}"><view class="form-input">{{time || '＋ 添加时刻'}}</view></picker><button wx:if="{{time}}" class="icon-button" bindtap="clearTime" disabled="{{scheduleLocked || shareOnly || saving || uncertain}}" aria-label="删除时刻">×</button></view><text class="form-helper">不填时刻即当天安排，不限定时刻。</text></view>
