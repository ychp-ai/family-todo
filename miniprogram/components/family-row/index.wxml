<mp-cells ext-class="family-weui-cells">
  <mp-cell ext-class="family-weui-row" aria-role="button" data-id="{{item.id}}" bindtap="select" aria-label="查看 {{item.name}} 的家人与管理操作">
    <view slot="icon" class="family-symbol"><image class="icon" src="/assets/home-brand.svg"/></view>
    <view class="family-row-copy"><text class="strong">{{item.name}}</text><text class="paragraph">{{item.myRole === 'owner' ? '我管理的家庭' : '我加入的家庭'}} · 拥有人 {{item.ownerName}}</text></view>
    <image slot="footer" class="icon" src="/assets/chevron.svg"/>
  </mp-cell>
</mp-cells>
