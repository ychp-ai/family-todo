<view class="task-card {{!item.occurrence.canRecord && !batchMode ? 'task-readonly' : ''}} {{item.selected && batchMode ? 'selected' : ''}} {{item.occurrence.status !== 'pending' ? 'is-done' : ''}}">
  <view wx:if="{{!item.occurrence.canRecord && !batchMode}}" class="view-symbol" aria-label="仅可查看"><image src="/assets/eye.svg"/></view>
  <button wx:else class="check-button" disabled="{{writing || (batchMode ? !item.task.capabilities.canShare || !item.task.capabilities.canEdit : !item.occurrence.canRecord)}}" data-id="{{item.occurrence.id}}" bindtap="toggleTask" aria-label="{{batchMode ? '选择事项' : '记录或撤销完成'}}"><view class="check-circle"><text wx:if="{{batchMode}}">{{item.selected ? '✓' : ''}}</text><image wx:elif="{{item.occurrence.status === 'completed'}}" class="icon" src="/assets/check-white.svg"/><text wx:elif="{{item.occurrence.status === 'skipped'}}">−</text></view></button>
  <button class="task-main" data-id="{{item.occurrence.id}}" bindtap="openTask"><text class="strong">{{item.task.title}}</text><view class="task-meta"><text>{{item.occurrence.subjectName}}</text><text class="house-tag">{{item.task.familyName || '历史个人事项'}}</text></view><view class="task-meta"><text wx:if="{{showDate}}">{{item.occurrence.localDate}}</text><text>{{item.occurrence.time || '不限定时刻'}}{{item.task.schedule.kind === 'daily' ? ' · 每天' : item.task.schedule.kind === 'weekly' ? ' · 每周' : ''}}</text><view wx:if="{{item.warningLabel}}" class="task-warning"><image class="task-warning-icon" src="/assets/clock-warning.svg"/><text>{{item.warningLabel}}</text></view></view><text wx:if="{{item.statusLabel}}" class="record-note">{{item.statusLabel}}</text><image class="task-open-arrow" src="/assets/chevron.svg"/></button>
</view>
