<view class="task-card {{item.occurrence.status !== 'pending' ? 'is-done' : ''}}"><button class="check-button" disabled="{{writing || (batchMode ? !item.task.capabilities.canShare || !item.task.capabilities.canEdit : !item.occurrence.canRecord)}}" data-id="{{item.occurrence.id}}" bindtap="toggleTask" aria-label="{{item.occurrence.canRecord ? '记录或撤销完成' : '仅可查看'}}"><view class="check-circle"><text wx:if="{{batchMode}}">{{item.selected ? '✓' : ''}}</text><image wx:if="{{!batchMode && item.occurrence.status === 'completed'}}" class="icon" src="/assets/check-green.svg"/><text wx:elif="{{item.occurrence.status === 'skipped'}}">−</text><image wx:elif="{{!item.occurrence.canRecord}}" class="icon" src="/assets/lock.svg"/></view></button><button class="task-main" data-id="{{item.occurrence.id}}" bindtap="openTask"><text class="strong">{{item.task.title}}</text><view class="task-meta"><text class="house-tag {{!item.task.familyId ? 'personal' : ''}}">{{item.task.familyName || '个人事项'}}</text><text wx:if="{{showDate}}">{{item.occurrence.localDate}}</text><text>{{item.occurrence.subjectName}} · {{item.occurrence.time || '不限定时刻'}}</text><view wx:if="{{item.warningLabel}}" class="task-warning"><image class="task-warning-icon" src="/assets/clock-warning.svg"/><text>{{item.warningLabel}}</text></view></view><text wx:if="{{item.statusLabel}}" class="record-note">{{item.statusLabel}}</text></button></view>
