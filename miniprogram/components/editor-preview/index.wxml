<view class="flow-card"><text class="h3">下一次安排</text><text wx:if="{{previewLoading}}" class="paragraph">正在预览…</text><text wx:for="{{previewLoading ? [] : preview}}" wx:key="index" class="paragraph">{{item.localDate || '未安排'}} · {{item.time || '不限定时刻'}}</text><text class="form-helper">{{previewExplanation}}</text><text class="form-error">{{previewError}}</text><button class="text-button" bindtap="previewSchedule">查看接下来 3 次安排</button></view>
