<view class="profile-header"><button class="profile-avatar" bindtap="openProfile" aria-label="设置头像与昵称"><image wx:if="{{avatarPath}}" src="{{avatarPath}}" mode="aspectFill" binderror="avatarError"/><text wx:else>{{avatarInitial || '·'}}</text></button><view class="profile-copy"><button class="profile-name" bindtap="openProfile" aria-label="设置昵称">{{displayName || '正在加载昵称…'}}<image class="icon" src="/assets/edit-brand.svg"/></button><text class="paragraph">照应彼此的小家</text></view></view>
