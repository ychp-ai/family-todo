page{background:var(--canvas);color:var(--ink);font-family:var(--body);font-size:14px;line-height:1.5}view,button,text,input,textarea,scroll-view{box-sizing:border-box}button{width:auto;margin:0;border:0;padding:0;background:transparent;color:inherit;font:inherit;line-height:1.5;border-radius:0}button::after{border:0}button[disabled]{opacity:.5}input,textarea{font:inherit;color:inherit}button,picker{min-height:44px}image{vertical-align:middle}

button:not([size=mini]){width:auto;margin:0}
