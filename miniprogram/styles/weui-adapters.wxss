/* Shared half-screen geometry; visibility and close guards stay in each page. */
.app-weui-sheet.weui-half-screen-dialog {
  position:fixed; left:12px; right:12px; bottom:12px; width:auto;
  display:flex; flex-direction:column; min-height:0; max-height:90vh;
  padding:12px 24px calc(27px + env(safe-area-inset-bottom));
  border-radius:24px 24px 19px 19px; background:var(--canvas);
  color:var(--ink); font:inherit; z-index:51; animation:none; transform:none;
}
.app-weui-sheet .weui-half-screen-dialog__hd { padding:0; min-height:0; display:block; flex:none; }
.app-weui-sheet .weui-half-screen-dialog__hd__side { display:none; }
.app-weui-sheet .weui-half-screen-dialog__hd__main { padding:0; }
.app-weui-sheet .weui-half-screen-dialog__title { font:inherit; text-align:left; }
.app-weui-sheet .weui-half-screen-dialog__bd { padding:0; min-height:0; flex:0 1 auto; overflow:hidden; color:var(--ink); font:inherit; }
.app-weui-sheet .weui-half-screen-dialog__ft { display:none; }

/* Scoped adapters preserve the app's list geometry without changing other WeUI cells. */
.app-weui-cells.weui-cells__group { margin:0; }
.app-weui-cells .weui-cells { margin:0; background:transparent; color:var(--ink); font:inherit; overflow:visible; }
.app-weui-cells .weui-cells::before,
.app-weui-cells .weui-cells::after,
.app-weui-tool.weui-cell::before,
.app-weui-info.weui-cell::before { display:none; }
.app-weui-tool.weui-cell { padding:0; min-height:56px; gap:12px; font:inherit; font-size:14px; color:var(--ink); background:transparent; transition:transform 120ms cubic-bezier(.23,1,.32,1); }
.app-weui-tool-divider.weui-cell { border-top:1px solid var(--line); }
.app-weui-tool .weui-cell__hd,
.app-weui-info .weui-cell__hd { padding:0; margin:0; flex:none; }
.app-weui-tool .weui-cell__bd,
.app-weui-info .weui-cell__bd { min-width:0; }
.app-weui-tool .weui-cell__ft { padding:0; margin:0; display:flex; flex:none; }
.app-weui-tool:active { transform:scale(.98); }
.app-weui-info.weui-cell { padding:0; min-height:53px; gap:10px; font:inherit; font-size:12px; color:var(--ink); border-bottom:1px solid #f0eff4; }
.app-weui-info-last.weui-cell { border-bottom:0; }
.app-weui-info .weui-cell__ft { display:none; }
@media (prefers-reduced-motion:reduce) {
  .app-weui-tool.weui-cell { transition:none; }
  .app-weui-tool:active { transform:none; }
}
