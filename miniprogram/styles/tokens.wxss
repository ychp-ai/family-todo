page {
  --brand:#5059ad;--brand-dark:#3f478f;--paper:#fff;--canvas:#f5f6fa;--ink:#292b40;--muted:#696c80;--line:#e4e6ef;--lavender:#eceefa;--green:#376a55;--green-light:#eaf3ee;--peach:#f5e5d9;--rose:#f2e2e6;--display:"Kaiti SC","STKaiti","KaiTi",serif;--body:"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;--utility:"Avenir Next","PingFang SC",sans-serif;
  --danger:#a43d48;--readonly:#f2f4f7;--warning:#865b20;--warning-light:#fff2db;
  --color-brand:var(--brand);--color-page:var(--canvas);--color-surface:var(--paper);--color-text-primary:var(--ink);--color-text-secondary:var(--muted);--color-border:var(--line);--radius-card:18px;--radius-control:12px;--space-page:18px;
}
